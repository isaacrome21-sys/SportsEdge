      "realized_filled_roi"
    ],
    "evaluation_checkpoints": {
      "freeze_status": "FROZEN_BEFORE_FIRST_FORMAL_PERFORMANCE_EVALUATION",
      "frozen_at": "2026-09-14T10:40:00Z",
      "candidate_n": [100, 250, 500, 1000],
      "persisted_n": [100, 250, 500, 1000],
      "filled_n": [100, 250, 500, 1000],
      "between_checkpoint_status": "COLLECT_ONLY_NO_FORMAL_PERFORMANCE_CLAIM",
      "no_optional_looks": true
    },
    "candidate_ledger": {
      "append_only": true,
      "flat_stake_units": 1.0,
      "candidate_identity_rule": "FIRST_QUALIFYING_SIGNAL_PER_EVENT_MARKET_OUTCOME_SOFT_BOOK",
