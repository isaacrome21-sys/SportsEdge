{
  "policy_id": "MARKET_MAKER_RADAR_V1",
  "version": "1.3.0",
  "status": "ACTIVE_LAYER_B_HARD_MARKET",
  "description": "Price-only market-maker lead/lag and stale-soft-book radar with frozen pre-signal thresholds, cross-book retrieval hygiene, fixed-offset takeability checks, immutable stale-price candidate ledgering, and preregistered evaluation checkpoints. Public splits, RLM labels, capper opinion, and unverified sharp-action labels cannot create a signal.",
  "model_free": true,
  "evidence_class": "LAYER_B_HARD_MARKET_DIAGNOSTIC",
  "authority": {
    "model_p_authority": false,
    "predictive_model_input": false,
    "truth_gate_input": false,
    "promotion_authority": false,
    "eligibility_authority": false,
    "staking_authority": false,
    "official_authority": false,
    "automatic_wager_authority": false,
    "manual_candidate_review_authority": true,
    "alert_authority": true
  },
  "books": {
    "market_makers": ["pinnacle"],
    "soft_books": ["draftkings", "fanduel"],
    "provider_required": ["circa"]
  },
  "markets": ["h2h", "spreads", "totals"],
  "timing": {
    "expected_poll_cadence_seconds": 300,
    "max_recent_age_seconds": 900,
    "change_time_source_priority": ["book_last_update", "captured_at"],
    "same_timestamp_rule": "SYNCHRONOUS_NOT_LEADER",
    "same_capture_rule": "ALLOW_DISTINCT_TRUSTWORTHY_PROVIDER_TIMESTAMPS_ONLY_OTHERWISE_SYNCHRONOUS",
    "lead_follow_window_seconds": 900,
    "steam_window_seconds": 300,
    "max_cross_book_retrieval_skew_seconds": 30,
    "require_provider_retrieval_timestamp_for_signal": true,
    "provider_quote_timestamp_requirement": "TRUSTWORTHY_SOURCE_TIMESTAMP_REQUIRED_FOR_WITHIN_POLL_LEADER",
    "provider_quote_age_default": "UNKNOWN_UNLESS_SOURCE_EXPOSES_TRUSTWORTHY_TIMESTAMP"
  },
  "takeability": {
    "persistence_recheck_enabled": true,
    "persistence_recheck_offset_seconds": 30,
    "persistence_recheck_tolerance_seconds": 10,
    "exact_contract_required": true,
    "offered_price_is_not_assumed_takeable": true,
    "persisted_price_is_takeability_proxy_only": true,
    "persisted_price_is_not_fill_proof": true,
    "execution_fields": [
      "offered_price_american",
      "attempted_price_american",
      "filled_price_american",
      "stake_requested_units",
      "stake_accepted_units",
      "attempted_at",
      "filled_at"
    ]
  },
  "alerts": {
