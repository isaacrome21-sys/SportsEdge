        "h2h": "PINNACLE_TO_DRAFTKINGS_STALE_PRICE_H2H_V1",
        "spreads": "PINNACLE_TO_DRAFTKINGS_STALE_PRICE_SPREADS_V1",
        "totals": "PINNACLE_TO_DRAFTKINGS_STALE_PRICE_TOTALS_V1"
      },
      "fanduel": {
        "h2h": "PINNACLE_TO_FANDUEL_STALE_PRICE_H2H_V1",
        "spreads": "PINNACLE_TO_FANDUEL_STALE_PRICE_SPREADS_V1",
        "totals": "PINNACLE_TO_FANDUEL_STALE_PRICE_TOTALS_V1"
      }
    },
    "never_blend_source_families": true,
    "minimum_n_for_claim": 100,
    "status_before_minimum_n": "INSUFFICIENT",
    "report_metrics": [
