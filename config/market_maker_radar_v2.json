      "persistence_record_is_separate": true,
      "execution_record_is_separate": true,
      "settlement_is_separate_record": true,
      "settlement_method": "LAST_TIMING_ELIGIBLE_PINNACLE_PRESTART_EXACT_CONTRACT",
      "clv_close_max_age_seconds": 900,
      "exact_contract_required": true,
      "different_point_close_status": "UNGRADABLE_NO_EXACT_CONTRACT_CLOSE",
      "unsettled_status": "PENDING_CLOSE",
      "validation_status_before_100": "INSUFFICIENT"
