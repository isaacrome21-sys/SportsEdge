    "historical_reclassification_forbidden": true,
    "change_requires_new_policy_version": true,
    "frozen_fields": {
      "timing.lead_follow_window_seconds": 900,
      "timing.steam_window_seconds": 300,
      "timing.max_cross_book_retrieval_skew_seconds": 30,
      "takeability.persistence_recheck_offset_seconds": 30,
      "takeability.persistence_recheck_tolerance_seconds": 10,
      "alerts.stale_offer_fair_probability_gap_pp": 1.0,
      "alerts.minimum_spread_or_total_line_gap": 0.5,
      "alerts.minimum_price_implied_probability_move_pp": 0.25,
      "alerts.minimum_soft_followers": 1,
      "alerts.steam_min_books": 3,
      "grading.candidate_ledger.clv_close_max_age_seconds": 900,
      "grading.candidate_ledger.exact_contract_required": true,
      "grading.evaluation_checkpoints.candidate_n": [100, 250, 500, 1000],
      "grading.evaluation_checkpoints.persisted_n": [100, 250, 500, 1000],
      "grading.evaluation_checkpoints.filled_n": [100, 250, 500, 1000]
    }
  },
  "signal_classes": {
    "market_maker_lead": "PRIMARY_HARD_MARKET",
