    "minimum_spread_or_total_line_gap": 0.5,
    "minimum_price_implied_probability_move_pp": 0.25,
    "minimum_soft_followers": 1,
    "steam_min_books": 3,
    "threshold_status": "FROZEN_RESEARCH_ALERT_THRESHOLD_NOT_VALIDATED_EDGE_FLOOR"
  },
  "threshold_freeze": {
    "status": "FROZEN_BEFORE_FIRST_LEAD_LAG_SIGNAL",
