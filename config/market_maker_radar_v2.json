    "line_advantage_candidate": "PRIMARY_HARD_MARKET_UNPRICED_DIFFERENT_LINE",
    "multi_book_steam": "SECONDARY_PRICE_ONLY",
    "soft_move_unconfirmed": "DIAGNOSTIC_ONLY",
    "public_split_divergence": "ANNOTATION_ONLY",
    "rlm": "ANNOTATION_ONLY_REQUIRES_NEWS_ATTRIBUTION"
  },
  "run_it_independence": {
