    "rule": "MARKET_PRICE_OPPORTUNITY_AND_HARD_MARKET_SIGNAL_FROM_THE_SAME_PRICE_MOVEMENT_COUNT_AS_ONE_CLASS",
    "dedupe_signal_classes": [
      "MARKET_MAKER_LEAD",
      "STALE_SOFT_PRICE",
      "LINE_ADVANTAGE_CANDIDATE",
      "MULTI_BOOK_STEAM",
      "RLM",
      "PUBLIC_SPLIT_DIVERGENCE"
    ]
  },
  "news_attribution": {
    "required_before_calling_move_rlm": true,
