{
  "policy_name": "CFB_TRUTH_GATE_V1",
  "version": "1.0.0",
  "sport": "CFB",
  "official_markets": ["MONEYLINE", "SPREAD", "TOTAL"],
  "props_certified": false,
  "min_edge_live": 0.03,
  "min_forward_seasons": 4,
  "min_promoted_sample": 200,
  "preferred_promoted_sample": 800,
  "require_model_brier_lt_novig_market": true,
  "require_model_logloss_lt_novig_market": true,
  "min_mean_novig_clv": 0.005,
  "min_clv_tstat": 2.0,
  "min_roi_after_vig": 0.0,
  "require_strictly_positive_roi": true,
  "calibration_slope_min": 0.90,
  "calibration_slope_max": 1.10,
  "max_abs_calibration_intercept": 0.03,
  "max_ece": 0.025,
  "allow_recent_2season_deterioration": false,
  "max_leakage_violations": 0,
  "require_paired_historical_prices": true,
  "require_pit_reproducibility": true,
  "require_policy_sha": true,
  "require_fresh_data": true,
  "require_fresh_quote": true,
  "require_two_sided_quote": true,
  "require_exposure_limits": true,
  "require_coverage_ok": true,
  "require_override_log_complete": true,
  "fail_closed_on_data_quality": true,
  "fail_closed_on_nan": true,
  "fail_closed_on_type_mismatch": true,
  "fail_closed_on_policy_violation": true,
  "public_betting_can_modify_model_p": false,
  "live_line_can_change_historical_certification": false,
  "clv": {
    "space": "NO_VIG_PROBABILITY",
    "definition": "closing_novig_probability_of_original_contract - decision_novig_probability_of_original_contract",
    "exact_same_contract_required": true,
    "allow_repricing": true,
    "repricing_requires_frozen_methodology": true,
    "unrepriceable_contract_counts_for_certification": false
  },
  "push_handling": {
    "simulation_outputs": ["P_WIN", "P_PUSH", "P_LOSS"],
    "ev_is_unconditional": true,
    "binary_probability_metrics_condition_on_non_push": true,
    "realized_pushes_excluded_from_binary_brier_logloss": true,
    "push_probability_reported_separately": true
  },
  "notes": "Main-market CFB policy only. Props require CFB_PROP_TRUTH_GATE. Historical certification and live decisioning are separate. No silent threshold migration."
}
