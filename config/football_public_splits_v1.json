{
  "policy_id": "FOOTBALL_PUBLIC_SPLITS_V1",
  "version": "1.1.0",
  "description": "Diagnostic-only football public betting split capture. Ticket/handle divergence and RLM-style labels are annotation only: they are not sharp-money evidence, cannot create a market signal, are never a predictive model input, and are never a Truth Gate certification input.",
  "diagnostics_only": true,
  "predictive_model_input": false,
  "truth_gate_input": false,
  "sharp_money_signal_authority": false,
  "wager_support_authority": false,
  "promotion_authority": false,
  "rlm_label_requires_news_attribution": true,
  "sources": {
    "VSIN_DK": {
      "sport": "CFB",
      "book": "DraftKings",
      "url": "https://data.vsin.com/betting-splits/?source=DK&sport=CFB",
      "freshness_minutes": 15,
      "role": "ANNOTATION_ONLY"
    }
  },
  "alerts": {
    "money_ticket_gap_pp": 15.0,
    "public_ticket_pct": 70.0,
    "minimum_point_move": 0.5,
    "moneyline_implied_probability_move": 0.01,
    "alert_role": "CONTEXT_ONLY_NOT_SHARP_SIGNAL"
  }
}
