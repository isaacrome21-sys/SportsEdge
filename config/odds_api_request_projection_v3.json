{
  "version": "odds_api_request_projection_v3",
  "supersedes": "odds_api_request_projection_v2",
  "as_of_utc": "2026-09-18T13:20:45Z",
  "purpose": "Derived inventory and cost invariant for every GitHub Actions workflow capable of spending The Odds API credits.",
  "discovery": {
    "workflow_globs": [
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml"
    ],
    "secret_reference_regex": "secrets\\.[A-Z0-9_]*(?:ODDS[A-Z0-9_]*API|THE_ODDS_API)[A-Z0-9_]*KEY[A-Z0-9_]*",
    "required_concurrency_group": "sportsedge-paid-odds-api",
    "required_cancel_in_progress": false,
    "consumer_set_is_derived": true,
    "undeclared_secret_touching_workflow_is_error": true,
    "stale_declared_workflow_is_error": true,
    "trigger_set_must_match": true
  },
  "credits_per_request_formula": "number_of_markets * number_of_regions",
  "provider_budget_path": "config/nfl_2026_provider_budget_v1.json",
  "confirmation_reserve_credits": 76,
  "reserve_owner_workflow": ".github/workflows/nfl-2026-line-capture.yml",
  "consumers": {
    ".github/workflows/closing-line-archive.yml": {
      "triggers": ["schedule", "workflow_dispatch"],
      "policy_file": "config/closing_line_archive_policy_v1.json",
      "reserve_role": "guarded_lower_priority",
      "guard_file": "scripts/capture_closing_line_archive_v3.py",
      "runtime_probe": "archive_policy",
      "request_profiles": {
        "game_markets": {
          "markets_path": "markets",
          "regions_path": "regions",
          "declared_credits_per_call": 3
        }
      }
    },
    ".github/workflows/football-nfl-forward-clv-collection.yml": {
      "triggers": ["schedule", "workflow_dispatch"],
      "policy_file": "config/football_nfl_forward_clv_provider_policy_v1.json",
      "reserve_role": "guarded_lower_priority",
      "guard_file": ".github/workflows/football-nfl-forward-clv-collection.yml",
      "runtime_probe": "nfl_forward_url_builder",
      "request_profiles": {
        "decision": {
          "markets_path": "request_profiles.decision.markets",
          "regions_path": "request_profiles.decision.regions",
          "guard_minimum_path": "request_profiles.decision.minimum_remaining_before_call",
          "declared_credits_per_call": 3
        },
        "close": {
          "markets_path": "request_profiles.close.markets",
          "regions_path": "request_profiles.close.regions",
          "guard_minimum_path": "request_profiles.close.minimum_remaining_before_call",
          "declared_credits_per_call": 5
        }
      }
    },
    ".github/workflows/nfl-2026-line-capture.yml": {
      "triggers": ["pull_request", "schedule", "workflow_dispatch"],
      "policy_file": "config/nfl_2026_confirmation_provider_policy_v1.json",
      "reserve_role": "reserve_owner",
      "runtime_probe": "nfl_confirmation_capture_config",
      "request_profiles": {
        "confirmation_fallback": {
          "markets_path": "request_profiles.confirmation_fallback.markets",
          "regions_path": "request_profiles.confirmation_fallback.regions",
          "declared_credits_per_call": 2
        }
      }
    },
    ".github/workflows/archive-mlb-game-odds-failover.yml": {
      "triggers": ["workflow_dispatch"],
      "policy_file": "config/mlb_game_odds_failover_provider_policy_v1.json",
      "reserve_role": "manual_only",
      "runtime_probe": "mlb_failover_constants",
      "request_profiles": {
        "game_odds": {
          "markets_path": "request_profiles.game_odds.markets",
          "regions_path": "request_profiles.game_odds.regions",
          "declared_credits_per_call": 6
        }
      }
    }
  },
  "invariants": {
    "mlb_scheduled_paid_workflows": 0,
    "every_secret_touching_workflow_is_declared": true,
    "every_paid_consumer_uses_shared_concurrency": true,
    "every_scheduled_non_owner_consumer_preserves_confirmation_reserve": true,
    "projection_costs_are_policy_derived": true,
    "push_pull_request_and_workflow_run_triggers_are_in_scope": true,
    "credential_values_are_never_logged": true
  },
  "evidence_unit_impact": {
    "artifact": "NONE",
    "feature_schema": "NONE",
    "predictive_code": "NONE",
    "acquisition_authority": "NONE",
    "policy": "OPERATIONAL_SPEND_GOVERNANCE_ONLY",
    "close_definition": "NONE",
    "operational_only": true
  }
}
