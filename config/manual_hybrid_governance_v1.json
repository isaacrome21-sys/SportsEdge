{
  "policy_id": "SPORTSEDGE_MANUAL_HYBRID_GOVERNANCE_V1",
  "version": "1.3.0",
  "sports": ["CFB", "MLB"],
  "canonical_document": "docs/SPORTSEDGE_MANUAL_HYBRID_AUDIT_CANONICAL_V1.md",
  "canonical_sources": {
    "CFB_TRUTH_GATE": "config/cfb_truth_gate_v1.json",
    "CFB_VALIDATION": "config/cfb_validation_policy_v1.json",
    "CFB_QUOTE_SYNC": "config/cfb_quote_sync_v1.json",
    "CFB_BENCHMARK": "config/cfb_market_benchmark_v1.json",
    "MLB_TRUTH_GATE": "config/mlb_truth_gate_v1.json",
    "MLB_VALIDATION": "config/mlb_validation_policy_v1.json",
    "MLB_BENCHMARK": "config/mlb_market_benchmark_v1.json",
    "MANUAL_HYBRID_EVIDENCE_GATE": "config/manual_hybrid_evidence_gate_v1.json",
    "POLICY_FREEZE_RECORD": "config/manual_hybrid_policy_freeze_v1.json",
    "PROVIDER_DEGRADE_MATRIX": "config/provider_degrade_matrix_v1.json",
    "DECISION_PROVENANCE_SCHEMA": "config/schemas/decision_provenance_v1.schema.json",
    "STRUCTURAL_REGIME_BOUNDARY_CONTRACT": "sportsedge/core/certification_lifecycle.py"
  },
  "resolved_thresholds": {
    "CFB": {
      "live_edge_floor": 0.03,
      "live_edge_floor_scope": "PER_CANDIDATE_DECISION",
      "portfolio_aggregation_cannot_satisfy_edge_floor": true,
      "portfolio_controls_apply_only_after_candidate_qualification": true,
      "live_quote_max_age_seconds": 180,
      "two_sided_pair_max_skew_seconds": 30,
      "spread_key_number_absolute_mass_tolerance": 0.015,
      "overall_ece_hard_max": 0.025,
      "actionable_edge_ece_diagnostic_max": 0.035,
      "actionable_edge_ece_status": "DIAGNOSTIC_ONLY_UNTIL_SEPARATELY_PROMOTED",
      "notes": "The 3.0% edge floor applies independently to each candidate wager. Portfolio construction, parlays, correlation, exposure or aggregate expected value may not rescue a sub-floor candidate. The 0.025 overall ECE bound is the canonical hard gate; 0.035 actionable-edge ECE is diagnostic only."
    },
    "MLB": {
      "live_edge_floor": 0.025,
      "live_edge_floor_scope": "PER_CANDIDATE_DECISION",
      "portfolio_aggregation_cannot_satisfy_edge_floor": true,
      "portfolio_controls_apply_only_after_candidate_qualification": true,
      "live_quote_max_age_seconds": 180,
      "two_sided_pair_max_skew_seconds": 30,
      "distribution_mass_absolute_tolerance": 0.015,
      "overall_ece_hard_max": 0.025
    }
  },
  "push_probability_basis": {
    "push_capable_markets": "EDGE compares Model P(WIN|NON_PUSH) to paired sportsbook NoVig P(WIN|NON_PUSH).",
    "model_nonpush_formula": "P_WIN / (1 - P_PUSH)",
    "market_pair_interpretation": "Two-sided spread/total prices are treated as conditional on non-push for edge benchmarking.",
    "ev_basis": "UNCONDITIONAL_P_WIN_P_PUSH_P_LOSS",
    "silent_mixing_of_probability_bases_forbidden": true
  },
  "monte_carlo_precision": {
    "minimum_paths": 10000,
    "max_standard_error_fraction_of_live_edge_floor": 0.20,
    "increase_paths_until_precision_passes": true,
    "seed_and_path_count_must_be_logged": true
  },
  "manual_hybrid_identity": {
    "same_feature_schema_required": true,
    "same_validators_required": true,
    "same_model_artifacts_required": true,
    "same_seed_policy_required": true,
    "same_quotes_produce_same_math": true,
    "allowed_differences": ["ACQUISITION_PROVENANCE", "MODE_LABEL"],
    "mathematical_difference": "FAIL_CLOSED"
  },
  "decision_provenance_required": [
    "MODEL_CODE_SHA",
    "MODEL_ARTIFACT_SHA",
    "FEATURE_SCHEMA_VERSION",
    "FEATURE_SCHEMA_SHA",
    "CALIBRATOR_SHA",
    "SIMULATION_ARTIFACT_SHA",
    "SEED_POLICY",
    "POLICY_SHA",
    "BENCHMARK_METHODOLOGY_SHA",
    "EVIDENCE_GATE_SHA",
    "DATA_CUTOFF",
    "QUOTE_IDS"
  ],
  "market_family_certification": {
    "independent_record_required": true,
    "canonical_market_id_required": true,
    "family_level_status_cannot_promote_child_market": true,
    "cross_market_inheritance_forbidden": true,
    "engine_existence_is_certification": false,
    "record_contract": "sportsedge/core/promotion_record.py"
  },
  "structural_break_governance": {
    "material_change_triggers": [
      "SCORING_RULE_CHANGE",
      "OVERTIME_FORMAT_CHANGE",
      "ROSTER_ELIGIBILITY_OR_TRANSFER_REGIME_CHANGE",
      "SCHEDULE_OR_SEASON_FORMAT_CHANGE",
      "MARKET_SETTLEMENT_RULE_CHANGE",
      "MATERIAL_DATA_DEFINITION_CHANGE"
    ],
    "material_change_action": "REVOKED",
    "independent_of_rolling_statistics": true,
    "automatic_repromotion_forbidden": true,
    "regime_boundary": {
      "row_rule": "KEEP_EVENT_TS_ON_OR_AFTER_EFFECTIVE_AT",
      "boundary_must_reference_dated_external_evidence": true,
      "source_authority_required": true,
      "external_evidence_sha_required": true,
      "policy_bundle_sha_required": true,
      "boundary_must_be_frozen_before_replay_starts": true,
      "season_level_exclusion_without_external_boundary_forbidden": true,
      "post_effective_row_exclusion_as_regime_row_forbidden": true,
      "performance_based_row_exclusion_forbidden": true,
      "notes": "The replay population is determined from the externally effective structural-change timestamp before performance is inspected. Dropping a season or row because its results are unfavorable is not a valid regime exclusion."
    },
    "repromotion_requires": [
      "NEW_MODEL_OR_POLICY_ARTIFACT_VERSION",
      "NEW_POLICY_BUNDLE_SHA",
      "FROZEN_EXTERNAL_REGIME_BOUNDARY_BEFORE_REPLAY",
      "FULL_PIT_REPLAY_UNDER_NEW_REGIME_CONTRACT",
      "ROW_EXCLUSION_EXACTLY_MATCHES_FROZEN_EXTERNAL_BOUNDARY",
      "ALL_SPORT_AND_MARKET_TRUTH_GATE_REQUIREMENTS",
      "ALL_REQUIRED_ATTESTATIONS"
    ]
  },
  "threshold_governance": {
    "silent_migration_forbidden": true,
    "change_requires_new_version_and_sha": true,
    "final_holdout_may_not_tune_thresholds": true,
    "threshold_freeze_must_precede_final_holdout_inspection": true,
    "prospective_freeze_record_required": true
  },
  "notes": "This file resolves cross-document ambiguity without weakening sport-specific Truth Gates. Sport-specific machine-readable policies remain authoritative for their own gates."
}
