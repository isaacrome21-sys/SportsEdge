{
  "schema_version": "MARKET_PROVIDER_CONTRACT_V1",
  "authority": "ROUTING_AND_PROVENANCE_ONLY",
  "promotion_authority": false,
  "model_p_authority": false,
  "non_silent_satisfaction": true,
  "rules": [
    {
      "provider": "ESPN_SCOREBOARD",
      "transport": "PUBLIC_NO_CREDENTIAL",
      "markets": ["MONEYLINE", "RUN_LINE", "TOTALS"],
      "book_identity": {
        "basis": "SOURCE_PAYLOAD_PROVIDER_DISPLAY_NAME",
        "required": true,
        "fallback_book": "espn_partner",
        "fallback_satisfies_exact_book_contract": false
      },
      "freshness": {
        "basis": "SOURCE_NATIVE_TIMESTAMP",
        "ttl_seconds": 60,
        "timestamp_required": true
      },
      "eligible_for_book_agnostic_context": true,
      "eligible_for_exact_book_contract": "ONLY_WHEN_SOURCE_PAYLOAD_EXPLICITLY_IDENTIFIES_REQUIRED_BOOK",
      "ineligible_markets": ["NRFI", "YRFI", "PLAYER_PROPS", "TEAM_TOTALS", "ADDITIONAL_DERIVATIVES"]
    },
    {
      "provider": "CFBD_LINES",
      "transport": "FREE_API_KEY",
      "markets": ["MONEYLINE", "SPREAD", "TOTALS"],
      "book_identity": {
        "basis": "SOURCE_PAYLOAD_PROVIDER_NAME",
        "required": true,
        "named_book_allowlist": ["DraftKings", "FanDuel", "BetMGM", "Caesars", "ESPN BET", "Bovada", "bet365"],
        "consensus_excluded": true
      },
      "freshness": {
        "basis": "FETCH_TIME_PROVENANCE_ONLY_NO_SOURCE_NATIVE_QUOTE_TIMESTAMP",
        "source_native_timestamp_available": false,
        "fetch_timestamp_recorded": true,
        "fetch_timestamp_is_quote_observation": false,
        "ttl_seconds": null,
        "timestamp_required": false,
        "ttl_eligible": false
      },
      "eligible_for_book_agnostic_context": true,
      "context_only": true,
      "eligible_for_exact_book_contract": false,
      "exact_book_contract_eligible": false,
      "closing_benchmark_eligible": false,
      "model_p_eligible": false,
      "truth_gate_eligible": false,
      "promotion_authority": false,
      "staking_authority": false,
      "official_authority": false
    },
    {
      "provider": "SELENE_CONTEXT",
      "transport": "MANUAL_BROWSER_CAPTURE",
      "base_url": "https://app.seleneodds.com",
      "markets": ["MONEYLINE", "SPREAD", "RUN_LINE", "TOTALS", "TEAM_TOTALS", "NRFI", "YRFI", "PLAYER_PROPS", "ADDITIONAL_DERIVATIVES"],
      "book_identity": {
        "basis": "DISPLAYED_BOOKMAKER_OR_EXCHANGE",
        "required": true,
        "unlabeled_price_rejected": true
      },
      "freshness": {
        "basis": "MANUAL_CAPTURE_TIME_PROVENANCE",
        "capture_timestamp_required": true,
        "source_native_timestamp_required": false,
        "capture_time_is_not_source_native_quote_time": true,
        "ttl_seconds": null,
        "ttl_eligible": false
      },
      "eligible_for_book_agnostic_context": true,
      "context_only": true,
      "eligible_for_exact_book_contract": false,
      "exact_book_contract_eligible": false,
      "closing_benchmark_eligible": false,
      "model_p_eligible": false,
      "truth_gate_eligible": false,
      "promotion_authority": false,
      "staking_authority": false,
      "official_authority": false,
      "automation_policy": "DISABLED_UNTIL_DOCUMENTED_API_AND_GOVERNED_INTEGRATION"
    },
    {
      "provider": "THE_ODDS_API",
      "transport": "METERED_API_KEY",
      "markets": ["MONEYLINE", "RUN_LINE", "TOTALS", "TEAM_TOTALS", "NRFI", "YRFI", "PLAYER_PROPS", "ADDITIONAL_DERIVATIVES"],
      "book_identity": {
        "basis": "SOURCE_PAYLOAD_BOOKMAKER_KEY",
        "required": true
      },
      "freshness": {
        "basis": "SOURCE_SPECIFIC",
        "ttl_seconds": 300
      },
      "eligible_for_book_agnostic_context": true,
      "eligible_for_exact_book_contract": "WHEN_REQUEST_AND_PAYLOAD_ESTABLISH_REQUIRED_BOOK"
    }
  ],
  "hard_failures": [
    "SOURCE_DOES_NOT_COVER_MARKET",
    "SOURCE_BOOK_IDENTITY_MISSING_FOR_EXACT_BOOK_CONTRACT",
    "SOURCE_TIMESTAMP_MISSING_WHEN_REQUIRED",
    "SOURCE_TIMESTAMP_STALE",
    "FALLBACK_MUST_NOT_INHERIT_PRIMARY_PROVIDER_IDENTITY",
    "FETCH_TIME_MUST_NOT_SATISFY_SOURCE_NATIVE_FRESHNESS",
    "CONSENSUS_PROVIDER_INELIGIBLE_FOR_CFBD_CONTEXT",
    "SELENE_CONTEXT_MUST_NOT_SATISFY_MODEL_P_TRUTH_GATE_PROMOTION_STAKING_OR_OFFICIAL_AUTHORITY"
  ]
}
