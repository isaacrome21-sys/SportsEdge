{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SPORTSEDGE_CFB_AUDIT_MANIFEST_V1",
  "title": "SportsEdge CFB Audit Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sport", "game_id", "market", "selection", "model_version", "feature_version",
    "calibrator_version", "simulation_version", "prior_version", "decay_schedule_hash",
    "variance_model_version", "key_number_method", "data_cutoff", "feature_asof_ts",
    "odds_snapshot_id", "market_benchmark_id", "coverage_report_id", "market_coverage_report_id",
    "book", "price", "quote_timestamp", "decision_timestamp", "model_p", "no_vig_market_p",
    "edge", "ev", "kelly", "historical_gate_status", "live_decision", "spec_sha", "policy_sha",
    "benchmark_methodology_sha", "exposure_sha", "market_context_sha", "feature_source_policy_sha",
    "entity_registry_sha", "validation_attestation_sha"
  ],
  "properties": {
    "sport": {"const": "CFB"},
    "game_id": {"type": "string", "minLength": 1},
    "market": {"enum": ["MONEYLINE", "SPREAD", "TOTAL"]},
    "selection": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "feature_version": {"type": "string", "minLength": 1},
    "calibrator_version": {"type": "string", "minLength": 1},
    "simulation_version": {"type": "string", "minLength": 1},
    "prior_version": {"type": "string", "minLength": 1},
    "decay_schedule_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "variance_model_version": {"type": "string", "minLength": 1},
    "key_number_method": {"type": "string", "minLength": 1},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "feature_asof_ts": {"type": "string", "format": "date-time"},
    "odds_snapshot_id": {"type": "string", "minLength": 1},
    "market_benchmark_id": {"type": "string", "minLength": 1},
    "coverage_report_id": {"type": "string", "minLength": 1},
    "market_coverage_report_id": {"type": "string", "minLength": 1},
    "book": {"type": "string", "minLength": 1},
    "line": {"type": ["number", "null"]},
    "price": {"type": "number"},
    "quote_timestamp": {"type": "string", "format": "date-time"},
    "decision_timestamp": {"type": "string", "format": "date-time"},
    "model_p": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "no_vig_market_p": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "edge": {"type": "number"},
    "ev": {"type": "number"},
    "kelly": {"type": "number", "minimum": 0.0},
    "historical_gate_status": {"type": "string", "minLength": 1},
    "live_decision": {"enum": ["OFFICIAL_BET", "NO_BET", "BLOCKED", "SHADOW_QUALIFIED"]},
    "spec_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "policy_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "benchmark_methodology_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "exposure_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "market_context_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "feature_source_policy_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "entity_registry_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "validation_attestation_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "override_id": {"type": ["string", "null"]}
  }
}
