{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SPORTSEDGE_DECISION_PROVENANCE_V1",
  "title": "SportsEdge Decision Provenance V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sport", "mode", "model_code_sha", "model_artifact_sha", "feature_schema_version",
    "feature_schema_sha", "calibrator_sha", "simulation_artifact_sha", "seed_policy",
    "policy_sha", "benchmark_methodology_sha", "evidence_gate_sha", "data_cutoff"
  ],
  "properties": {
    "sport": {"type": "string", "minLength": 1},
    "mode": {"enum": ["MANUAL", "HYBRID", "AUTOMATIC"]},
    "model_code_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "model_artifact_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "feature_schema_version": {"type": "string", "minLength": 1},
    "feature_schema_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "calibrator_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "simulation_artifact_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "seed_policy": {"type": "string", "minLength": 1},
    "policy_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "benchmark_methodology_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "evidence_gate_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "data_cutoff": {"type": "string", "format": "date-time"}
  }
}
