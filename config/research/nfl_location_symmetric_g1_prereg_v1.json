{
  "schema": "NFL_LOCATION_SYMMETRIC_G1_PREREG_V1",
  "status": "FROZEN_BEFORE_IMPLEMENTATION",
  "candidate_family": "NFL_LOCATION_SYMMETRIC_RIDGE_G1",
  "purpose": "Test whether a lower-dimensional structurally symmetric representation of the existing PIT-safe M2 feature contract improves market-blind NFL margin and total location accuracy. This is a new research candidate, not V2K Attempt 6 and not a relabel of M2.",
  "predecessor_context": {
    "m2_status": "UNFROZEN_FAILED_HISTORICAL_GATES",
    "v2k_status": "BUDGET_EXHAUSTED_NO_PASS",
    "preserve_prior_failure_receipts": true,
    "prior_candidate_attempts_are_not_reset": true
  },
  "source_contract": {
    "history_builder": "sportsedge/sports/nfl/m2_history_features.py",
    "feature_builder": "sportsedge/sports/nfl/m2.py::build_nfl_m2_features",
    "required_feature_contract": "NFL_M2_V1_MARKET_BLIND",
    "sportsbook_fields_as_model_inputs": false,
    "same_game_realized_information_as_features": false,
    "future_games_as_features": false
  },
  "targets": {
    "margin": "home_score-away_score",
    "total": "home_score+away_score"
  },
  "representation": {
    "margin": {
      "form": "intercept + ridge(home_minus_away)",
      "diff_features": [
        "adj_off_epa",
        "adj_def_epa",
        "pass_epa",
        "rush_epa",
        "pressure_for",
        "pressure_allowed",
        "success_rate",
        "explosive_rate",
        "qb_adjustment",
        "prior_efficiency",
        "rest_diff_days",
        "travel_miles",
        "timezone_crossings",
        "short_week",
        "bye_week"
      ],
      "invariant": "Swapping home and away feature dictionaries negates every non-intercept margin feature. For a fitted model, prediction(row)+prediction(swapped_row)=2*intercept."
    },
    "total": {
      "form": "intercept + ridge(symmetric_sum_and_environment)",
      "sum_features": [
        "adj_off_epa",
        "adj_def_epa",
        "pass_epa",
        "rush_epa",
        "pressure_for",
        "pressure_allowed",
        "success_rate",
        "explosive_rate",
        "qb_adjustment",
        "prior_efficiency",
        "travel_miles",
        "timezone_crossings",
        "short_week",
        "bye_week"
      ],
      "environment_features": [
        "abs_rest_diff_days",
        "wind_mph_mean",
        "roof_closed_mean",
        "prior_weight_mean"
      ],
      "invariant": "Swapping home and away feature dictionaries leaves every total feature unchanged."
    }
  },
  "fit": {
    "family": "SEPARATE_STANDARDIZED_L2_RIDGE",
    "margin_and_total_penalties_selected_independently": true,
    "alpha_grid": [0.1, 1.0, 10.0, 100.0, 1000.0],
    "alpha_selection": "TRAINING_ONLY_INNER_EXPANDING_SEASON_CV_LOWEST_RMSE_TIE_STRONGER_REGULARIZATION",
    "intercept_penalized": false,
    "feature_standardization": "TRAINING_FOLD_MEAN_STD_ONLY",
    "huber_not_part_of_g1": true
  },
  "development_validation": {
    "evidence_role": "REUSED_RESEARCH_HISTORY_NOT_UNTOUCHED_PROMOTION_EVIDENCE",
    "outer_folds": [
      {"train_seasons": [2018, 2019, 2020], "test_season": 2021},
      {"train_seasons": [2018, 2019, 2020, 2021], "test_season": 2022},
      {"train_seasons": [2018, 2019, 2020, 2021, 2022], "test_season": 2023},
      {"train_seasons": [2018, 2019, 2020, 2021, 2022, 2023], "test_season": 2024},
      {"train_seasons": [2018, 2019, 2020, 2021, 2022, 2023, 2024], "test_season": 2025}
    ],
    "shuffle": false,
    "inner_selection_may_use_outer_test_season": false,
    "metrics": ["RMSE", "MAE"],
    "actual_targets_only": true,
    "market_reference": {
      "spread_reference_mean": "-spread_line",
      "total_reference_mean": "total_line",
      "role": "REPORT_ONLY_NOT_MODEL_INPUT_NOT_PRIMARY_LOCATION_GATE"
    }
  },
  "baseline": {
    "candidate": "sportsedge/sports/nfl/m2.py::fit_nfl_m2_score_model",
    "model_id": "nfl_m2_ridge_v1",
    "ridge_alpha": 10.0,
    "same_outer_train_and_test_rows_required": true
  },
  "acceptance": {
    "margin": {
      "candidate_rmse_fold_wins_vs_m2_min": 3,
      "candidate_mae_fold_wins_vs_m2_min": 3,
      "aggregate_rmse_strictly_lower_than_m2": true,
      "aggregate_mae_strictly_lower_than_m2": true
    },
    "total": {
      "candidate_rmse_fold_wins_vs_m2_min": 3,
      "candidate_mae_fold_wins_vs_m2_min": 3,
      "aggregate_rmse_strictly_lower_than_m2": true,
      "aggregate_mae_strictly_lower_than_m2": true
    },
    "conjunctive": true,
    "market_reference_not_required_to_pass_location_gate": true
  },
  "post_location_distribution_gate": {
    "run_only_if_location_gate_passes": true,
    "team_means": {
      "home": "(total_mu+margin_mu)/2",
      "away": "(total_mu-margin_mu)/2",
      "negative_or_zero_mean_policy": "FAIL_CLOSED"
    },
    "shape_engine": "sportsedge/sports/nfl/discrete_v2.py::score_grid",
    "shape_engine_bytes_unchanged_for_g1_location_test": true,
    "required_later_metrics": [
      "moneyline_brier",
      "spread_log_loss",
      "total_log_loss",
      "calibration",
      "signed_key_mass_-7_-3_3_7",
      "push_mass",
      "team_total_probability_sanity"
    ],
    "distribution_success_cannot_retroactively_change_location_fit": true
  },
  "prospective_boundary": {
    "2026_prior_weeks_are_not_clean_final_holdout": true,
    "earliest_clean_evidence": "Predictions created after the exact frozen G1 code+artifact identity, beginning no earlier than 2026 Week 6",
    "backfill_allowed": false,
    "prospective_results_may_not_tune_frozen_g1": true
  },
  "implementation_paths": {
    "model": "sportsedge/sports/nfl/location_symmetric_g1.py",
    "validation": "sportsedge/sports/nfl/location_symmetric_g1_validation.py",
    "tests": "tests/test_nfl_location_symmetric_g1.py"
  },
  "authority": {
    "research_only": true,
    "model_p": false,
    "truth_gate": false,
    "promotion": false,
    "staking": false,
    "official": false,
    "bettor_facing_release": false
  }
}
