{
  "schema": "SPORTSEDGE_NFL_GAME_SCRIPT_V2_PRELOCK",
  "status": "FROZEN_BEFORE_V2_SCORING",
  "frozen_date": "2026-10-01",
  "candidate_role": "RESEARCH_SHADOW_ONLY",
  "supersedes_failed_candidate": {
    "candidate": "NFL_GAME_SCRIPT_V1",
    "reason": "V1 failed its predeclared fit-support gate because TIE had 18 team-games versus minimum 100.",
    "v1_fit_window_exposed": [2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
    "v1_validation_2025_accessed": false,
    "reuse_v1_fit_window_for_v2_fit": false
  },
  "objective": "Learn smooth market-blind pass/rush workload multipliers as a function of simulated team final margin without sparse discrete margin buckets.",
  "source": {
    "provider": "nflverse",
    "dataset": "nflfastR play-by-play",
    "uri_template": "https://github.com/nflverse/nflverse-data/releases/download/pbp/play_by_play_{season}.csv",
    "exact_raw_sha256_required": true,
    "retrieved_at_required": true,
    "market_columns_allowed_as_features": false,
    "model_fields": [
      "season",
      "season_type",
      "game_id",
      "posteam",
      "posteam_type",
      "home_score",
      "away_score",
      "pass_attempt",
      "rush_attempt",
      "qb_scramble",
      "qb_kneel"
    ]
  },
  "fit_window": {
    "seasons": [2011, 2012, 2013, 2014, 2015],
    "season_type": "REG",
    "postseason_included": false,
    "reason": "Fresh development window not used by failed V1 and recent enough to avoid early-era PBP instability."
  },
  "excluded_from_v2_fit_or_selection": {
    "seasons": [2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
    "reason": "Exposed by failed V1 development fit."
  },
  "validation_window": {
    "season": 2025,
    "season_type": "REG",
    "one_look": true,
    "status": "CLEAN_UNUSED_BY_V1",
    "cannot_tune_v2_after_scoring": true,
    "not_fresh_promotion_evidence": true,
    "2026_role": "FORWARD_SHADOW_ONLY"
  },
  "play_classification": {
    "qb_kneel": "EXCLUDE",
    "qb_scramble": "RUSH",
    "otherwise_pass_attempt_1": "PASS",
    "otherwise_rush_attempt_1": "RUSH",
    "otherwise": "IGNORE",
    "pass_rush_double_count_allowed": false
  },
  "normalization": {
    "unit": "TEAM_GAME",
    "reference": "LEAVE_ONE_OUT_TEAM_SEASON_MEAN",
    "minimum_team_season_games": 8
  },
  "model": {
    "family": "RIDGE_ON_FIXED_PIECEWISE_LINEAR_MARGIN_BASIS",
    "target_outputs": ["PASS_MULTIPLIER", "RUSH_MULTIPLIER"],
    "margin_input": "TEAM_FINAL_MARGIN",
    "basis": {
      "type": "HINGE_LINEAR",
      "terms": [
        "1",
        "margin",
        "max(0, margin + 14)",
        "max(0, margin + 7)",
        "max(0, margin)",
        "max(0, margin - 7)",
        "max(0, margin - 14)"
      ],
      "fixed_knots": [-14, -7, 0, 7, 14]
    },
    "standardization": "TRAINING_FOLD_ONLY",
    "ridge_alpha_grid": [0.1, 1.0, 10.0, 100.0],
    "alpha_selection": "LEAVE_ONE_SEASON_OUT_CV_ON_2011_2015_ONLY",
    "selection_metric": "EQUAL_WEIGHT_MEAN_OF_PASS_RATIO_AND_RUSH_RATIO_MAE",
    "monotonic_constraint": false,
    "post_fit_clipping": false,
    "downstream_multiplier_range": [0.4, 1.8],
    "out_of_range_behavior": "FAIL_CLOSED"
  },
  "validation_application": {
    "pregame_baseline": "STRICTLY_PRIOR_8_TEAM_GAMES_EXP_DECAY_0.85",
    "script_input_during_validation": "REALIZED_FINAL_MARGIN_FOR_HELDOUT_JOINT_DISTRIBUTION_TEST_ONLY",
    "baseline_comparator": "NO_SCRIPT_MULTIPLIER_1.0",
    "primary_metric": "EQUAL_WEIGHT_MEAN_OF_PASS_AND_RUSH_MAE",
    "pass_rules": {
      "combined_mae_relative_improvement_min": 0.01,
      "pass_mae_must_not_worsen": true,
      "rush_mae_must_not_worsen": true,
      "pass_mean_error_abs_max_plays": 1.5,
      "rush_mean_error_abs_max_plays": 1.5
    },
    "failure_spends_validation_window": true,
    "no_post_result_retune": true
  },
  "integration_boundary": {
    "this_prelock_changes_unified_engine": false,
    "future_integration_requires_separate_pr": true,
    "sampled_total_continues_to_control_overall_pace": true,
    "fitted_script_controls_pass_vs_rush_mix_only": true
  },
  "authority": {
    "changes_attempt9_owner": false,
    "creates_model_p": false,
    "truth_gate_authority": false,
    "official_authority": false,
    "promotion_authority": false,
    "staking_authority": false,
    "backfill_authority": false
  }
}
