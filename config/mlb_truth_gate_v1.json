{
  "policy_id": "MLB_TRUTH_GATE_V1",
  "version": "1.1.0",
  "description": "SportsEdge MLB Truth Gate. Fail-closed. Certification is independent per canonical market ID; market family is grouping metadata only.",
  "certification_unit": "CANONICAL_MARKET_ID_WITHIN_MARKET_FAMILY",
  "cross_market_aggregation_for_certification_forbidden": true,
  "cross_market_inheritance_forbidden": true,
  "hard_gates": {
    "pit_reproducibility_required": true,
    "max_leakage_violations": 0,
    "min_forward_seasons": 3,
    "target_forward_seasons": 5,
    "brier_must_beat_market": true,
    "logloss_must_beat_market": true,
    "min_season_fold_scoring_win_rate": 0.6,
    "min_mean_novig_clv": 0.004,
    "min_clv_t_stat": 2.0,
    "min_roi_after_vig": 0.0,
    "require_strictly_positive_roi": true,
    "target_roi_after_vig": 0.015,
    "calibration_slope_min": 0.9,
    "calibration_slope_max": 1.1,
    "calibration_intercept_abs_max": 0.03,
    "max_ece": 0.025,
    "min_promoted_sample_absolute": 200,
    "preferred_promoted_sample": 600,
    "recent_two_season_deterioration_allowed": false,
    "require_live_two_sided_quote": true,
    "require_data_freshness": true,
    "require_frozen_policy_hash": true,
    "edge_floor": 0.025,
    "require_exposure_limits": true,
    "require_coherent_joint_constraints": true,
    "require_model_code_sha": true,
    "require_feature_schema_sha": true,
    "require_structural_change_clearance": true
  },
  "diagnostics_only": {
    "hit_rate_buckets": {
      "edge_2.5_to_4": 0.53,
      "edge_4_to_6": 0.545,
      "edge_6_plus": 0.56
    }
  },
  "promotion_states": [
    "NO_ENGINE",
    "EXPERIMENTAL",
    "EVIDENCE_INCOMPLETE",
    "VALIDATED_MODEL",
    "READY_FOR_POLICY",
    "OFFICIAL",
    "REVOKED"
  ],
  "market_families": [
    "V7_GAME",
    "HITTER_JOINT",
    "PITCHER_JOINT",
    "F5",
    "SPECIALIZED"
  ],
  "examples_of_independent_market_ids": [
    "MONEYLINE",
    "RUN_LINE",
    "TOTALS",
    "F5_MONEYLINE",
    "F5_RUN_LINE",
    "F5_TOTALS",
    "NRFI",
    "YRFI",
    "TEAM_TOTALS",
    "PITCHER_STRIKEOUTS",
    "HITTER_HITS"
  ],
  "notes": "Numeric MLB policy is explicit. A V7_GAME family pass cannot certify MONEYLINE, RUN_LINE and TOTALS as one pooled unit. Each canonical market ID must independently satisfy the gate with its own sample/metrics/settlement contract. Engine existence never implies OFFICIAL."
}
