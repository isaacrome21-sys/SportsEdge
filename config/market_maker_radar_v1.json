{
  "policy_id": "MARKET_MAKER_RADAR_V1",
  "version": "1.2.0",
  "status": "ACTIVE_LAYER_B_HARD_MARKET",
  "description": "Price-only market-maker lead/lag and stale-soft-book radar with isolated 4C line-history corroboration. Price leadership is the primary signal. Public splits, RLM labels, capper opinion, and unverified sharp-action labels cannot create a signal.",
  "model_free": true,
  "evidence_class": "LAYER_B_HARD_MARKET_DIAGNOSTIC",
  "authority": {
    "model_p_authority": false,
    "predictive_model_input": false,
    "truth_gate_input": false,
    "promotion_authority": false,
    "eligibility_authority": false,
    "staking_authority": false,
    "official_authority": false,
    "alert_authority": true
  },
  "books": {
    "market_makers": ["pinnacle", "fourc_pinnacle"],
    "soft_books": ["draftkings", "fanduel", "fourc_draftkings", "fourc_fanduel"],
    "provider_required": ["circa"]
  },
  "markets": ["h2h", "spreads", "totals"],
  "timing": {
    "expected_poll_cadence_seconds": 300,
    "max_recent_age_seconds": 900,
    "change_time_source_priority": ["book_last_update", "captured_at"],
    "same_timestamp_rule": "SYNCHRONOUS_NOT_LEADER",
    "same_capture_rule": "ALLOW_DISTINCT_BOOK_LAST_UPDATE_ONLY_OTHERWISE_SYNCHRONOUS",
    "lead_follow_window_seconds": 900,
    "steam_window_seconds": 300
  },
  "alerts": {
    "stale_offer_fair_probability_gap_pp": 1.0,
    "minimum_spread_or_total_line_gap": 0.5,
    "minimum_price_implied_probability_move_pp": 0.25,
    "minimum_soft_followers": 1,
    "steam_min_books": 3,
    "threshold_status": "RESEARCH_ALERT_THRESHOLD_NOT_VALIDATED_EDGE_FLOOR"
  },
  "signal_classes": {
    "market_maker_lead": "PRIMARY_HARD_MARKET",
    "stale_soft_price": "PRIMARY_HARD_MARKET",
    "line_advantage_candidate": "PRIMARY_HARD_MARKET_UNPRICED_DIFFERENT_LINE",
    "multi_book_steam": "SECONDARY_PRICE_ONLY",
    "soft_move_unconfirmed": "DIAGNOSTIC_ONLY",
    "public_split_divergence": "ANNOTATION_ONLY",
    "rlm": "ANNOTATION_ONLY_REQUIRES_NEWS_ATTRIBUTION"
  },
  "news_attribution": {
    "required_before_calling_move_rlm": true,
    "default_state": "UNADJUDICATED",
    "simultaneous_move_interpretation": "NEWS_OR_COMMON_INFORMATION_POSSIBLE"
  },
  "public_splits": {
    "role": "ANNOTATION_ONLY",
    "sharp_signal_authority": false,
    "model_input_authority": false,
    "wager_support_authority": false
  },
  "exchange_liquidity": {
    "role": "OPTIONAL_HARD_MARKET_CORROBORATION",
    "automated_capture": false,
    "sources": ["novig", "prophetx", "kalshi"],
    "require_executable_price_or_resting_liquidity": true,
    "wallet_or_capper_label_is_insufficient": true,
    "model_input_authority": false
  },
  "external_line_history": {
    "fourc": {
      "source_class": "FOURC_LINE_HISTORY_V1",
      "site_url": "https://www.4codds.com/",
      "role": "INDEPENDENT_AGGREGATOR_CORROBORATION_ONLY",
      "transport_status": "PROVENANCE_BOUND_CAPSULE_IMPORT_ONLY",
      "automated_scraping": false,
      "documented_public_api_bound": false,
      "book_namespace": "fourc_",
      "books": ["fourc_pinnacle", "fourc_draftkings", "fourc_fanduel"],
      "provider_quote_timestamp_authority": false,
      "displayed_move_time_semantics": "AGGREGATOR_OBSERVATION_TIME",
      "native_sportsbook_identity_authority": false,
      "draftkings_evidence_authority": false,
      "truth_gate_input": false,
      "promotion_authority": false,
      "official_authority": false,
      "never_blend_with_native_source_families": true
    }
  },
  "grading": {
    "primary_metric": "CLV",
    "source_family_ids": {
      "pinnacle_to_draftkings": "PINNACLE_TO_DRAFTKINGS_LEAD_LAG_V1",
      "pinnacle_to_fanduel": "PINNACLE_TO_FANDUEL_LEAD_LAG_V1",
      "fourc_pinnacle_to_fourc_draftkings": "FOURC_PINNACLE_TO_DRAFTKINGS_LEAD_LAG_V1",
      "fourc_pinnacle_to_fourc_fanduel": "FOURC_PINNACLE_TO_FANDUEL_LEAD_LAG_V1"
    },
    "never_blend_source_families": true,
