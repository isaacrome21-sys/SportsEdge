{
  "validation_policy_id": "CFB_VALIDATION_POLICY_V1",
  "version": "1.3.0",
  "sport": "CFB",
  "main_markets": ["MONEYLINE", "SPREAD", "TOTAL"],
  "predictive_scoring_population": "ALL_PIT_SUPPORTABLE_NON_PUSH_ROWS",
  "economic_scoring_population": "SHADOW_QUALIFIED_CANDIDATES_ONLY",
  "reason": "Brier/log-loss/calibration must not be improved by post-prediction bet selection; CLV and ROI measure the frozen candidate policy.",
  "outer_folds": {
    "type": "SEASON_WALK_FORWARD",
    "shuffle": false,
    "require_train_seasons_strictly_before_test_season": true,
    "opponent_adjustment_fit_inside_each_outer_fold": true,
    "regularization_fit_inside_each_outer_fold": true,
    "calibration_requires_inner_oof_predictions": true,
    "residual_distribution_requires_inner_oof_predictions": true,
    "minimum_forward_seasons_for_truth_gate": 4
  },
  "prior_ablation": {
    "required": true,
    "population": "SAME_OUTER_FOLD_PIT_ROWS",
    "compare": ["WITH_FROZEN_PRIOR", "NO_PRIOR"],
    "metrics": ["BRIER", "LOGLOSS", "CLV", "ROI"],
    "report_by_week": [1, 2, 3, 4],
    "held_out_test_season_may_not_choose_prior_decay": true
  },
  "key_number_calibration": {
    "markets": ["SPREAD"],
    "margins": [-7, -3, 3, 7],
    "absolute_mass_tolerance": 0.015,
    "required_per_outer_fold": true,
    "manual_probability_boosts_forbidden": true
  },
  "probability_basis": {
    "push_capable_edge_basis": "CONDITIONAL_ON_NON_PUSH",
    "model_formula": "P_WIN/(1-P_PUSH)",
    "market_formula": "PAIRED_NO_VIG_PROBABILITY_CONDITIONAL_ON_NON_PUSH",
    "ev_basis": "UNCONDITIONAL_WIN_PUSH_LOSS",
    "mixed_basis_forbidden": true
  },
  "monte_carlo_precision": {
    "minimum_paths": 10000,
    "max_standard_error_fraction_of_live_edge_floor": 0.20,
    "increase_paths_until_precision_passes": true,
    "store_seed_policy_and_path_count": true
  },
  "calibration": {
    "overall_ece_hard_max": 0.025,
    "actionable_edge_ece_diagnostic_max": 0.035,
    "actionable_edge_ece_status": "DIAGNOSTIC_ONLY_UNTIL_SEPARATELY_PROMOTED",
    "raw_and_calibrated_metrics_required": true
  },
  "recent_two_season_deterioration": {
    "method_id": "CFB_RECENT_2SEASON_DETERIORATION_V1",
    "definition": "TRUE when, for either Brier or log loss, the model fails to beat the frozen no-vig benchmark in each of the two most recent completed outer seasons. One isolated weak season is reported but is not by itself a two-season deterioration.",
    "brier_failure": "brier_model >= brier_benchmark",
    "logloss_failure": "logloss_model >= logloss_benchmark",
    "requires_two_completed_outer_seasons": true
  },
  "structural_change": {
    "material_change_revokes_independent_of_statistics": true,
    "lifecycle_policy": "config/manual_hybrid_governance_v1.json",
    "automatic_repromotion_forbidden": true
  },
  "segmented_reports": {
    "weeks": ["1", "2", "3", "4", "5_PLUS"],
    "favorite_size": ["0_3", "3_7", "7_14", "14_PLUS"],
    "conference_strength": true,
    "fbs_fcs_classification": true
  },
  "shadow_firewall": {
    "shadow_qualified_is_historical_research_state_only": true,
    "shadow_qualified_cannot_be_live_official_bet": true,
    "shadow_qualified_cannot_set_historical_market_status_official": true,
    "live_official_requires_truth_gate_official": true
  },
  "required_attestations": [
    "PIT_LEAKAGE",
    "MARKET_BLIND_FEATURE_SCAN",
    "ENTITY_REGISTRY",
    "PRIOR_DECAY_FOLD_INTEGRITY",
    "PRIOR_ABLATION",
    "OPPONENT_ADJUST_FOLD_INTEGRITY",
    "CALIBRATION_FOLD_INTEGRITY",
    "OOF_RESIDUAL_FOLD_INTEGRITY",
    "KEY_NUMBER_CALIBRATION",
    "QUOTE_SYNC_POLICY",
    "PROBABILITY_BASIS_PUSH_CONTRACT",
    "MONTE_CARLO_PRECISION",
    "DECISION_PROVENANCE",
    "MANUAL_HYBRID_INPUT_CONTRACT",
    "MODE_IDENTITY",
    "GAME_COVERAGE_ACCOUNTING",
    "MARKET_COVERAGE_ACCOUNTING",
    "BENCHMARK_REPLAYABILITY",
    "HISTORICAL_DATA_READINESS",
    "SHADOW_LIVE_FIREWALL",
    "STRUCTURAL_CHANGE_CLEARANCE"
  ]
}
