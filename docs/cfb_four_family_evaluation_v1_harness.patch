+# NOT_RUN reasons (draft section 7 kill criteria / pre-scoring aborts).
+NOT_RUN_OWNER_RULINGS_UNRESOLVED = "OWNER_RULINGS_UNRESOLVED"
+NOT_RUN_FREEZE_NOT_ESTABLISHED = "FREEZE_NOT_ESTABLISHED"
+NOT_RUN_FREEZE_HASH_MISMATCH = "FREEZE_HASH_MISMATCH"
+NOT_RUN_FORWARD_ONLY_CANDIDATE = "CANDIDATE_MODE_FORWARD_ONLY"
+NOT_RUN_PIT_AUDIT_FAILURE = "PIT_AUDIT_FAILURE"
+NOT_RUN_NEUTRALITY_GUARD_REFUSAL = "NEUTRALITY_GUARD_REFUSAL"
+NOT_RUN_FOLD_BELOW_MINIMUM = "FOLD_BELOW_MINIMUM"
+NOT_RUN_INSUFFICIENT_BOUND_DATA = "INSUFFICIENT_BOUND_DATA"
+NOT_RUN_PROGRAM_ABORT = "PROGRAM_ABORT_TWO_OR_MORE_FAMILIES_BELOW_FLOOR"
+
+#: Illinois-college ESPN id registry, frozen on main by PR #2148
+#: (``artifacts/free_models.py: IL_COLLEGE_ESPN_IDS``). A fixture with
+#: either competitor in this registry is removed before the population
+#: is counted (draft sections 4.1 and 6.2).
+IL_COLLEGE_ESPN_IDS = frozenset(
+    {
+        "356",   # Illinois
+        "77",    # Northwestern
+        "305",   # DePaul
+        "2350",  # Loyola Chicago
