+        VERDICT_DEMONSTRATED_EDGE_RESEARCH_ONLY,
+        VERDICT_REFUTED,
+    }
+)
+
+# Exclusion reason strings (draft section 6.2, verbatim).
+EXCL_IL_COLLEGE = "BLOCKED_PREPRICING_IL_COLLEGE_EXCLUDED"
+EXCL_TEAMS_UNRESOLVED = "BLOCK_TEAMS_UNRESOLVED"
+EXCL_NON_FBS_OPPONENT = "POPULATION_NON_FBS_OPPONENT"
+EXCL_PUSH_INTEGER_LINE = "PUSH_AT_INTEGER_LINE_EXCLUDED"
