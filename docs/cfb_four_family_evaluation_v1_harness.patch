+"""CFB four-family evaluation harness — RESEARCH ONLY. NOT ACTIVATED.
+
+Implements the machinery specified by the CFB market-family evaluation
+preregistration draft (``PREREGISTRATION_DRAFT.md``, prepared 2026-10-13,
+SHA-256 57f1d81b1cc2cd82d09e12395d1dbbc0d8b37012fca1e93bf4774129c2f381bf).
+The draft is NOT FILED and NOT IN FORCE. This module is machinery only:
+
+* It performs NO evaluation of real data. Every scored path in this module
+  is exercised by the synthetic-fixture battery
+  (``tests/test_cfb_four_family_evaluation_20261013.py``) and nothing else.
+* A scored run requires an established freeze (owner-named freeze SHA plus
+  the SPORTSEDGE_EVIDENCE_UNIT_V1 manifest hashes) AND all three owner
+  rulings of draft section 10 resolved in configuration. The shipped
+  configuration (``config/research/cfb_four_family_evaluation_v1.json``)
+  carries every ruling as UNRULED and ``freeze_sha: null``, so the harness
+  refuses (NOT_RUN) out of the box, pre-scoring, consuming no attempt.
+* The candidate evaluated by the historical leg is the frozen production
+  code in a DECLARED injury-neutral evaluation configuration (draft CAND-2).
+  The neutrality of every model input is machine-checked here: injury/QB
+  context is neutralized or omitted by construction, and the scorer
+  REFUSES any input in which a non-neutral value reaches the model.
+* The CFBD market comparison is DESCRIPTIVE ONLY, end to end. The label
+  ``DESCRIPTIVE_MARKET_COMPARISON_NOT_A_VERDICT`` is attached to every
+  descriptive record this module emits; no descriptive path can emit a
+  verdict of any kind.
+* No verdict this module can emit changes any family status. Every result
+  record carries ``family_status: UNVALIDATED`` and
+  ``status_change: NONE``. The strongest label any verdict function here
+  can produce is ``DEMONSTRATED_EDGE_RESEARCH_ONLY`` (forward leg, draft
+  section 5.5), and the historical leg's ceiling is
+  ``BEATS_FROZEN_BASELINE``.
+
+This module performs no network access, no file IO, and no subprocess
+work; inputs arrive as in-memory records and results leave as in-memory
+records. Binding real data snapshots, the frozen production engine, and
+real CFBD lines is freeze-time work under a separate execution ruling
+(draft section 9) and is deliberately absent here.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import random
+from dataclasses import dataclass, field, replace
+from datetime import datetime
+from statistics import NormalDist
+from typing import Callable, Iterable, Mapping, Optional, Protocol, Sequence
+
+# --------------------------------------------------------------------------
+# Standing labels and vocabulary (draft sections 5.4, 5.5, 6.2)
+# --------------------------------------------------------------------------
+
+FAMILIES: tuple[str, ...] = ("moneyline", "spread", "total", "team_total")
+
+#: The standing descriptive label. It must appear in every record the
+#: CFBD comparison emits; a CFBD comparison can never emit a verdict.
+DESCRIPTIVE_LABEL = "DESCRIPTIVE_MARKET_COMPARISON_NOT_A_VERDICT"
+
+#: Verbatim limitation text that accompanies every descriptive readout
+#: (draft section 5.4).
+DESCRIPTIVE_LIMITATION_TEXT = (
+    "CFBD closing lines carry no per-row timestamps; this comparison is "
+    "descriptive only and supports no claim of market outperformance, no "
+    "CLV statement, and no promotion input."
+)
+
+#: Emitted in place of any market-relative number for team_total, which
+#: has no CFBD comparator at all (draft section 2.4).
+NO_HISTORICAL_MARKET_COMPARATOR = "NO_HISTORICAL_MARKET_COMPARATOR"
+
+#: The evaluated object, named in every output (draft section 3.1, CAND-2).
+EVALUATED_OBJECT_INJURY_NEUTRAL = (
+    "frozen CFB game engine, injury-neutral evaluation configuration"
+)
+EVALUATED_OBJECT_PRODUCTION_FORWARD = (
+    "frozen CFB game engine, production configuration (forward leg)"
+)
+
+#: Families stay UNVALIDATED at every outcome of this program (draft
+#: sections 5.4 and 9 item 6).
+FAMILY_STATUS_UNVALIDATED = "UNVALIDATED"
+
+# Historical-leg verdict labels (draft section 5.4).
+VERDICT_BEATS_FROZEN_BASELINE = "BEATS_FROZEN_BASELINE"
+VERDICT_WORSE_THAN_FROZEN_BASELINE = "WORSE_THAN_FROZEN_BASELINE"
+VERDICT_INCONCLUSIVE = "INCONCLUSIVE"
+VERDICT_INCONCLUSIVE_COVERAGE = "INCONCLUSIVE (COVERAGE)"
+
+# Forward-leg verdict labels (draft section 5.5). DEMONSTRATED_EDGE_
+# RESEARCH_ONLY is the ceiling of the entire program.
+VERDICT_DEMONSTRATED_EDGE_RESEARCH_ONLY = "DEMONSTRATED_EDGE_RESEARCH_ONLY"
+VERDICT_REFUTED = "REFUTED"
+ACCRUAL_ONLY_NOT_A_VERDICT = "ACCRUAL_ONLY_NOT_A_VERDICT"
+
+#: Every verdict label this module is capable of emitting. A battery test
+#: pins this set: nothing above the program ceiling may ever appear here.
+ALL_VERDICT_LABELS = frozenset(
+    {
+        VERDICT_BEATS_FROZEN_BASELINE,
+        VERDICT_WORSE_THAN_FROZEN_BASELINE,
+        VERDICT_INCONCLUSIVE,
