+
+class HarnessError(Exception):
+    """Base class for harness refusals."""
+
+
+class ConfigError(HarnessError):
+    """The configuration is invalid or expresses a prohibited posture."""
+
+
+class NonNeutralInputError(HarnessError):
+    """A non-neutral input would reach the model. Fail closed."""
+
+
+class PitAuditError(HarnessError):
+    """A feature or selection input used information from its target
+    game or later. Fail closed (draft section 7, kill criterion 3)."""
+
+
+# --------------------------------------------------------------------------
+# Configuration (draft sections 3-5; section 10 rulings as switches)
+# --------------------------------------------------------------------------
+
+#: Owner ruling switch 1 (draft section 10 item 1): which candidate the
+#: historical leg evaluates.
+CANDIDATE_MODES = ("CAND_2_INJURY_NEUTRAL", "CAND_3_FORWARD_ONLY")
+#: Owner ruling switch 2 (draft section 10 item 2): the CFBD role. The
+#: descriptive ceiling is structural: no value expressing a verdict-grade
+#: CFBD role is admissible in configuration at all.
+CFBD_ROLES = ("DESCRIPTIVE_ONLY", "DESCRIPTIVE_STRENGTHENED")
+#: Owner ruling switch 3a (draft section 10 item 3): population boundary.
+POPULATION_RULES = ("EXCLUDE_FCS_OPPONENTS", "INCLUDE_FCS_OPPONENTS")
+#: Owner ruling switch 3b (draft section 10 item 3): fold window.
+FOLD_WINDOWS = ("SEASONS_2021_2025", "SEASONS_2018_2025")
+
+UNRULED = "UNRULED"
+
+
+@dataclass(frozen=True)
+class OwnerRulings:
+    """The owner's section 10 decisions, as configuration. UNRULED is
+    the shipped state; an UNRULED switch blocks any scored run."""
+
+    candidate_mode: str = UNRULED
+    cfbd_role: str = UNRULED
+    cfbd_verification_steps_completed: bool = False
+    population_rule: str = UNRULED
+    fold_window: str = UNRULED
+
+    def unresolved(self) -> tuple[str, ...]:
+        out = []
+        if self.candidate_mode not in CANDIDATE_MODES:
+            out.append("candidate_mode")
+        if self.cfbd_role not in CFBD_ROLES:
+            out.append("cfbd_role")
+        if self.population_rule not in POPULATION_RULES:
+            out.append("population_rule")
+        if self.fold_window not in FOLD_WINDOWS:
+            out.append("fold_window")
+        return tuple(out)
+
+
+@dataclass(frozen=True)
+class EvalConfig:
+    """Every number the draft leaves to configuration, with the draft's
+    proposed values as the defaults. Changing a value here is a config
+    change, never a code change; after filing, draft section 7 binds:
+    thresholds never change retroactively."""
+
+    families: tuple[str, ...] = FAMILIES
+    burn_in_seasons: tuple[int, ...] = tuple(range(2013, 2021))
+    evaluation_seasons: tuple[int, ...] = (2021, 2022, 2023, 2024, 2025)
+    fold_min_games: int = 500
+    pooled_min_games: int = 2500
+    folds_required_better: int = 3
+    coverage_floor: float = 0.75
+    bootstrap_reps: int = 10000
+    bootstrap_seed: Optional[int] = None  # predeclared at filing
+    log_loss_eps: float = 1e-15
+    calibration_slope_band: tuple[float, float] = (0.8, 1.25)
+    calibration_intercept_band: float = 0.10
+    # Forward-leg targets (draft section 5.5), pre-registered here; the
+    # forward leg itself is undesigned and unauthorized (section 2.2).
+    forward_target_games: int = 300
+    forward_target_blocks: int = 20
+    forward_extension_games: int = 600
+    # Ratings/distribution machinery constants. These are the harness's
+    # working values for the BASE-1 construction and the walk-forward
+    # state; at freeze time they are either frozen as-is or replaced by
+    # the frozen production construction, and the selection of any fitted
+    # value happens inside the training window only (draft section 4.1).
+    ratings_k: float = 0.12
+    ratings_regression_to_mean: float = 0.85  # applied at season rollover
+    home_advantage_points: float = 2.5  # BASE-1 static constant
+    margin_sigma: float = 19.0
+    total_sigma: float = 13.5
+    team_total_sigma: float = 10.5
+    league_mean_total_points: float = 55.0
+    il_college_espn_ids: frozenset = IL_COLLEGE_ESPN_IDS
+    rulings: OwnerRulings = field(default_factory=OwnerRulings)
+
+    def validate(self) -> None:
+        if tuple(self.families) != FAMILIES:
+            raise ConfigError(
+                "family set is fixed by the draft: %r" % (FAMILIES,)
+            )
+        if set(self.burn_in_seasons) & set(self.evaluation_seasons):
+            raise ConfigError("burn-in and evaluation seasons overlap")
+        if self.fold_min_games <= 0 or self.pooled_min_games <= 0:
+            raise ConfigError("sample floors must be positive")
+        if not 0.0 < self.coverage_floor <= 1.0:
+            raise ConfigError("coverage floor must be in (0, 1]")
+        if self.folds_required_better < 1:
+            raise ConfigError("folds_required_better must be >= 1")
+        if self.bootstrap_reps < 100:
+            raise ConfigError("bootstrap_reps below 100 cannot support a CI")
+        # The CFBD descriptive ceiling is structural: a configuration
+        # expressing a verdict-grade (or any unlisted) CFBD role is
+        # invalid, whether or not the rulings have been made.
+        if self.rulings.cfbd_role not in CFBD_ROLES + (UNRULED,):
+            raise ConfigError(
+                "cfbd_role %r is not admissible: CFBD evidence is "
+                "descriptive-only under this program and no configuration "
+                "may express a verdict-grade CFBD role"
+                % (self.rulings.cfbd_role,)
+            )
+        if self.rulings.candidate_mode not in CANDIDATE_MODES + (UNRULED,):
+            raise ConfigError(
+                "unknown candidate_mode %r" % (self.rulings.candidate_mode,)
+            )
+        if self.rulings.population_rule not in POPULATION_RULES + (UNRULED,):
+            raise ConfigError(
+                "unknown population_rule %r" % (self.rulings.population_rule,)
+            )
+        if self.rulings.fold_window not in FOLD_WINDOWS + (UNRULED,):
+            raise ConfigError(
+                "unknown fold_window %r" % (self.rulings.fold_window,)
+            )
+        if (
+            self.rulings.cfbd_role == "DESCRIPTIVE_STRENGTHENED"
+            and not self.rulings.cfbd_verification_steps_completed
+        ):
+            raise ConfigError(
+                "DESCRIPTIVE_STRENGTHENED requires the Sep 27 audit "
+                "verification steps to be recorded complete"
+            )
+
+
+@dataclass(frozen=True)
+class ResolvedConfig:
+    """An EvalConfig with every section 10 ruling applied. Only a
+    ResolvedConfig may drive a scored run."""
+
+    base: EvalConfig
+    evaluation_seasons: tuple[int, ...]
+    burn_in_seasons: tuple[int, ...]
+    include_fcs_opponents: bool
+    candidate_mode: str
+    cfbd_role: str
+
+
+def resolve_config(config: EvalConfig) -> ResolvedConfig:
+    """Apply the owner's rulings. Raises ConfigError listing every
+    unresolved switch; the draft's recommended rulings produce the
+    draft's proposed fold window and population."""
+    config.validate()
+    unresolved = config.rulings.unresolved()
+    if unresolved:
+        raise ConfigError(
+            "%s: owner rulings unresolved for: %s"
+            % (NOT_RUN_OWNER_RULINGS_UNRESOLVED, ", ".join(unresolved))
+        )
+    if config.rulings.fold_window == "SEASONS_2018_2025":
+        evaluation = tuple(range(2018, 2026))
+        burn_in = tuple(range(2013, 2018))
+    else:
+        evaluation = tuple(config.evaluation_seasons)
+        burn_in = tuple(config.burn_in_seasons)
+    return ResolvedConfig(
+        base=config,
+        evaluation_seasons=evaluation,
+        burn_in_seasons=burn_in,
+        include_fcs_opponents=(
+            config.rulings.population_rule == "INCLUDE_FCS_OPPONENTS"
+        ),
+        candidate_mode=config.rulings.candidate_mode,
+        cfbd_role=config.rulings.cfbd_role,
+    )
+
+
+def config_from_dict(payload: Mapping) -> EvalConfig:
+    """Build an EvalConfig from the shipped JSON companion's shape."""
+    rulings_payload = payload.get("rulings", {})
+    rulings = OwnerRulings(
+        candidate_mode=rulings_payload.get("candidate_mode", UNRULED),
+        cfbd_role=rulings_payload.get("cfbd_role", UNRULED),
+        cfbd_verification_steps_completed=bool(
+            rulings_payload.get("cfbd_verification_steps_completed", False)
+        ),
+        population_rule=rulings_payload.get("population_rule", UNRULED),
+        fold_window=rulings_payload.get("fold_window", UNRULED),
+    )
+    cfg = EvalConfig(
+        families=tuple(payload.get("families", FAMILIES)),
+        burn_in_seasons=tuple(payload.get("burn_in_seasons", range(2013, 2021))),
+        evaluation_seasons=tuple(
+            payload.get("evaluation_seasons", (2021, 2022, 2023, 2024, 2025))
+        ),
+        fold_min_games=int(payload.get("fold_min_games", 500)),
+        pooled_min_games=int(payload.get("pooled_min_games", 2500)),
+        folds_required_better=int(payload.get("folds_required_better", 3)),
+        coverage_floor=float(payload.get("coverage_floor", 0.75)),
+        bootstrap_reps=int(payload.get("bootstrap_reps", 10000)),
+        bootstrap_seed=payload.get("bootstrap_seed"),
+        log_loss_eps=float(payload.get("log_loss_eps", 1e-15)),
+        calibration_slope_band=tuple(
+            payload.get("calibration_slope_band", (0.8, 1.25))
+        ),
+        calibration_intercept_band=float(
+            payload.get("calibration_intercept_band", 0.10)
+        ),
+        forward_target_games=int(payload.get("forward_target_games", 300)),
+        forward_target_blocks=int(payload.get("forward_target_blocks", 20)),
+        forward_extension_games=int(
+            payload.get("forward_extension_games", 600)
+        ),
+        ratings_k=float(payload.get("ratings_k", 0.12)),
+        ratings_regression_to_mean=float(
+            payload.get("ratings_regression_to_mean", 0.85)
+        ),
+        home_advantage_points=float(payload.get("home_advantage_points", 2.5)),
+        margin_sigma=float(payload.get("margin_sigma", 19.0)),
+        total_sigma=float(payload.get("total_sigma", 13.5)),
+        team_total_sigma=float(payload.get("team_total_sigma", 10.5)),
+        league_mean_total_points=float(
+            payload.get("league_mean_total_points", 55.0)
+        ),
+        rulings=rulings,
+    )
+    cfg.validate()
+    return cfg
+
+
+def load_config_json(text: str) -> EvalConfig:
+    return config_from_dict(json.loads(text))
+
+
