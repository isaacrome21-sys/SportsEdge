+        config=cfg, scored_fraction=1.0,
+    )
+    assert record["verdict"] == "BEATS_FROZEN_BASELINE"
+    assert record["family_status"] == "UNVALIDATED"
+    assert record["status_change"] == "NONE"
+    assert record["folds_better_on_both_metrics"] == 5
