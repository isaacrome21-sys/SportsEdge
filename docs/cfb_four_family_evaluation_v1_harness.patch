+@dataclass(frozen=True)
+class GameRecord:
+    """One bound game from the historical snapshot. Scores are final
+    (full-game markets include overtime, draft section 4.1)."""
+
+    game_id: str
+    season: int
+    week: int
+    kickoff_utc: datetime
+    home_team_id: str
+    away_team_id: str
+    home_fbs: bool
+    away_fbs: bool
+    home_score: Optional[int]
+    away_score: Optional[int]
+    no_contest: bool = False
+
+    @property
+    def decided(self) -> bool:
+        return (
+            not self.no_contest
+            and self.home_score is not None
+            and self.away_score is not None
+        )
+
+
+@dataclass(frozen=True)
+class GameLines:
+    """The lines a family's probabilities are computed at: the captured
+    headline line only (draft section 5.1, same-threshold rule). In the
+    historical leg these come from the CFBD snapshot; in the forward leg
+    from the paired closing capture."""
+
+    spread_home: Optional[float] = None  # home spread, e.g. -1.5
+    total: Optional[float] = None
+    team_total_home: Optional[float] = None
+    team_total_away: Optional[float] = None
+    home_moneyline: Optional[int] = None
+    away_moneyline: Optional[int] = None
+
+
+@dataclass(frozen=True)
+class ExternalFeature:
+    """An externally supplied feature for a game, carrying the time its
+    value became available. The PIT audit (below) refuses any feature
+    whose availability is not strictly before its game's kickoff."""
+
+    game_id: str
+    name: str
+    value: float
+    available_at: datetime
+
+
+# --------------------------------------------------------------------------
+# The declared injury-neutral evaluation configuration (draft CAND-2)
+#
+# The frozen CFB engine consumes a context dict (artifacts/free_models.py
+# CONTEXT_KEYS["CFB"]): home_rating, away_rating, home_injury_pts,
+# away_injury_pts, home_form, away_form, weather_total_adj, rest_diff_adj.
+# In the evaluation configuration:
+#   * ALLOWED keys are copied from the walk-forward ratings state — the
+#     only inputs that are point-in-time reconstructible from completed
+#     games and schedule facts (draft section 3.1).
+#   * FORCE_ZERO keys are written explicitly as exactly 0.0: the injury
+#     points (no honest historical value exists), every owner-disabled
+#     factor under every key name (recent form home_form/away_form; rest
+#     rest_diff_adj and rest_adj), and weather_total_adj (no PIT-bound
+#     historical weather input exists in the freeze; declared-threshold
+#     weather is an unproven free factor and stays at zero here).
+#   * FORBIDDEN keys — any QB-context or availability key — must be
+#     ABSENT, not zeroed: the configuration omits them, and their
+#     presence in a model input is a refusal.
+# The scorer validates every input before any producer sees it, so a
+# non-neutral value cannot reach the model through any path.
+# --------------------------------------------------------------------------
+
+ALLOWED_CONTEXT_KEYS = frozenset({"home_rating", "away_rating"})
+FORCE_ZERO_CONTEXT_KEYS = frozenset(
+    {
+        "home_injury_pts",
+        "away_injury_pts",
+        "home_form",
+        "away_form",
+        "rest_diff_adj",
+        "rest_adj",
+        "rest",
+        "weather_total_adj",
+    }
+)
+STATIC_CONTEXT_KEYS = frozenset({"home_advantage_points"})
+
+
+def _is_forbidden_context_key(key: str) -> bool:
+    lowered = key.lower()
+    return (
+        lowered.startswith("qb")
+        or "_qb" in lowered
+        or lowered.endswith("_qb")
+        or "availab" in lowered
+        or "injury_report" in lowered
+        or lowered in {"starter", "starting_qb", "depth_chart"}
+    )
+
+
+@dataclass
+class CandidateGameInput:
+    """The exact input object a probability producer receives for one
+    game in the evaluation configuration."""
+
+    game_id: str
+    context: Mapping[str, float]
+    #: Fields present in the raw production-shaped context whose values
+    #: were NOT carried into the model input (provenance, draft 3.1).
+    neutralized_fields: tuple[str, ...] = ()
+    omitted_fields: tuple[str, ...] = ()
+
+    def validate_neutral(self) -> None:
+        for key, value in self.context.items():
+            if _is_forbidden_context_key(key):
+                raise NonNeutralInputError(
+                    "QB/availability context key %r present in evaluation "
+                    "input for game %s; the injury-neutral configuration "
+                    "omits it entirely" % (key, self.game_id)
+                )
+            if key in FORCE_ZERO_CONTEXT_KEYS:
+                if float(value) != 0.0:
+                    raise NonNeutralInputError(
+                        "context key %r carries non-neutral value %r for "
+                        "game %s; the evaluation configuration fixes it "
+                        "at exactly 0.0" % (key, value, self.game_id)
+                    )
+            elif key in ALLOWED_CONTEXT_KEYS or key in STATIC_CONTEXT_KEYS:
+                continue
+            else:
+                raise NonNeutralInputError(
+                    "context key %r is not on the evaluation "
+                    "configuration allowlist (game %s); unlisted inputs "
+                    "do not reach the model" % (key, self.game_id)
+                )
+
+
+def build_candidate_input(
+    game: GameRecord,
+    *,
+    home_rating: float,
+    away_rating: float,
+    home_advantage_points: float,
+    raw_context: Optional[Mapping[str, float]] = None,
+) -> CandidateGameInput:
+    """Construct the neutral model input for one game.
+
+    Ratings come from the walk-forward state (the only copied values).
+    ``raw_context`` is the production-shaped context, accepted solely so
+    its non-neutral fields can be recorded as neutralized/omitted in the
+    provenance — values from it are never copied.
+    """
+    context: dict[str, float] = {
+        "home_rating": float(home_rating),
+        "away_rating": float(away_rating),
+        "home_advantage_points": float(home_advantage_points),
+    }
+    for key in sorted(FORCE_ZERO_CONTEXT_KEYS):
+        if key in ("rest", "rest_adj"):
+            continue  # alternate key names for the same disabled factor
+        context[key] = 0.0
+    neutralized: list[str] = []
+    omitted: list[str] = []
+    for key, value in (raw_context or {}).items():
+        if _is_forbidden_context_key(key):
+            omitted.append(key)
+        elif key in FORCE_ZERO_CONTEXT_KEYS and float(value) != 0.0:
+            neutralized.append(key)
+    return CandidateGameInput(
+        game_id=game.game_id,
+        context=context,
+        neutralized_fields=tuple(sorted(neutralized)),
+        omitted_fields=tuple(sorted(omitted)),
+    )
+
+
+# --------------------------------------------------------------------------
+# Probability producers
+#
+# A producer maps a validated CandidateGameInput plus the game's lines
+# to family probabilities. The candidate producer in a real run is the
+# frozen production engine, bound at freeze time; it is injected here,
+# never imported, so this module stays machinery. BASE-1 ships as
+# RatingsBaselineProducer.
+# --------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class FamilyProbabilities:
+    moneyline_home_win: float
+    spread_home_cover: Optional[float]
+    total_over: Optional[float]
+    team_total_home_over: Optional[float]
+    team_total_away_over: Optional[float]
+
+
+class ProbabilityProducer(Protocol):
+    name: str
+
+    def family_probabilities(
+        self, inp: CandidateGameInput, lines: GameLines
+    ) -> FamilyProbabilities:
+        ...
+
+
+def _cover_probability(mu: float, sigma: float, threshold: float) -> float:
+    """P(value > threshold) for a normal score variable, with push mass
+    at an integer threshold excluded and the remainder renormalized
+    (draft section 4.1: integer-line pushes are excluded from the
+    family's metric; the scored probability is the cover probability
+    over decisive outcomes)."""
+    dist = NormalDist(mu, sigma)
+    if float(threshold).is_integer():
+        # The discrete outcome landing exactly on the threshold is the
+        # push band [t - 0.5, t + 0.5]; score over decisive outcomes.
+        p_over = 1.0 - dist.cdf(threshold + 0.5)
+        p_under = dist.cdf(threshold - 0.5)
+        decisive = p_over + p_under
+        if decisive <= 0.0:
+            return 0.5
+        return p_over / decisive
+    return 1.0 - dist.cdf(threshold)
+
+
+class RatingsBaselineProducer:
+    """BASE-1 (draft section 3.2): team-strength ratings plus static
+    home advantage, and nothing else. Also used by the battery as the
+    stand-in producer; a real candidate is a different injected object.
+    """
+
+    name = "BASE_1_TEAM_STRENGTH_PLUS_STATIC_HOME_ADVANTAGE"
+
+    def __init__(self, config: EvalConfig):
+        self._cfg = config
+
+    def family_probabilities(
+        self, inp: CandidateGameInput, lines: GameLines
+    ) -> FamilyProbabilities:
+        cfg = self._cfg
+        ctx = inp.context
+        margin_mu = (ctx["home_rating"] - ctx["away_rating"]) + ctx[
+            "home_advantage_points"
+        ]
+        # Team expected scores split the league mean total by the margin.
+        home_mean = (cfg.league_mean_total_points + margin_mu) / 2.0
+        away_mean = (cfg.league_mean_total_points - margin_mu) / 2.0
+        margin_dist = NormalDist(margin_mu, cfg.margin_sigma)
+        p_home_win = 1.0 - margin_dist.cdf(0.0)
+        spread_p = None
+        if lines.spread_home is not None:
+            # Home covers when margin > -spread_home.
+            spread_p = _cover_probability(
+                margin_mu, cfg.margin_sigma, -float(lines.spread_home)
+            )
+        total_p = None
+        if lines.total is not None:
+            total_p = _cover_probability(
+                cfg.league_mean_total_points
+                + 0.0,  # totals mean is the league mean in BASE-1
+                cfg.total_sigma,
+                float(lines.total),
+            )
+        tt_home = None
+        if lines.team_total_home is not None:
+            tt_home = _cover_probability(
+                home_mean, cfg.team_total_sigma, float(lines.team_total_home)
+            )
+        tt_away = None
+        if lines.team_total_away is not None:
+            tt_away = _cover_probability(
+                away_mean, cfg.team_total_sigma, float(lines.team_total_away)
+            )
+        return FamilyProbabilities(
+            moneyline_home_win=p_home_win,
+            spread_home_cover=spread_p,
+            total_over=total_p,
+            team_total_home_over=tt_home,
+            team_total_away_over=tt_away,
+        )
+
+
+# --------------------------------------------------------------------------
+# Walk-forward ratings state (draft section 4.1: ratings for a scored
+# game come from games completed strictly before it, including games
+# earlier in the same validation season)
+# --------------------------------------------------------------------------
+
+
+class RatingsState:
+    """Point-scale team ratings updated game by game in kickoff order.
+    A snapshot taken before a game is scored can only contain results
+    of games already processed, which the fold engine orders strictly
+    before it — that ordering is the PIT discipline, and every emitted
+    prediction records its evidence game ids so the audit can verify
+    it after the fact."""
+
+    def __init__(self, config: EvalConfig):
+        self._cfg = config
+        self._ratings: dict[str, float] = {}
+        self._season_seen: Optional[int] = None
+        self.evidence_game_ids: list[str] = []
+
+    def rating(self, team_id: str) -> float:
+        return self._ratings.get(team_id, 0.0)
+
+    def update(self, game: GameRecord) -> None:
+        if not game.decided:
+            return
+        if self._season_seen is not None and game.season != self._season_seen:
+            shrink = self._cfg.ratings_regression_to_mean
+            for team in self._ratings:
+                self._ratings[team] *= shrink
+        self._season_seen = game.season
+        home_r = self.rating(game.home_team_id)
+        away_r = self.rating(game.away_team_id)
+        expected_margin = (home_r - away_r) + self._cfg.home_advantage_points
+        actual_margin = float(game.home_score - game.away_score)
+        delta = self._cfg.ratings_k * (actual_margin - expected_margin)
+        self._ratings[game.home_team_id] = home_r + delta
+        self._ratings[game.away_team_id] = away_r - delta
+        self.evidence_game_ids.append(game.game_id)
+
+
+# --------------------------------------------------------------------------
+# Settlement / grading (draft section 4.1)
+# --------------------------------------------------------------------------
+
+
+def grade_outcome(
+    game: GameRecord, family: str, lines: GameLines, side: str = "home"
+) -> Optional[float]:
+    """Realized outcome for one family row: 1.0 / 0.0, or None when the
+    row is excluded (push at an integer line; missing line)."""
+    if not game.decided:
+        return None
+    home = float(game.home_score)
+    away = float(game.away_score)
+    if family == "moneyline":
+        return 1.0 if home > away else 0.0
+    if family == "spread":
+        if lines.spread_home is None:
+            return None
+        margin = home - away
+        if margin == -float(lines.spread_home):
+            return None  # push at an integer line
+        return 1.0 if margin > -float(lines.spread_home) else 0.0
+    if family == "total":
+        if lines.total is None:
+            return None
+        total = home + away
+        if total == float(lines.total):
+            return None
+        return 1.0 if total > float(lines.total) else 0.0
+    if family == "team_total":
+        if side == "home":
+            line, scored = lines.team_total_home, home
+        else:
+            line, scored = lines.team_total_away, away
+        if line is None:
+            return None
+        if scored == float(line):
+            return None
+        return 1.0 if scored > float(line) else 0.0
+    raise HarnessError("unknown family %r" % (family,))
+
+
+# --------------------------------------------------------------------------
+# Population classification (draft sections 4.1 and 6.2)
+# --------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Exclusion:
+    game_id: str
+    reason: str
+
+
+def classify_population(
+    games: Sequence[GameRecord],
+    resolved: ResolvedConfig,
+    *,
+    known_team_ids: Optional[frozenset] = None,
+) -> tuple[list[GameRecord], list[Exclusion]]:
+    """Split bound games into the scored population and counted
+    exclusions. Illinois fixtures are removed before the population is
+    counted; they were never in the production population."""
+    cfg = resolved.base
+    population: list[GameRecord] = []
+    exclusions: list[Exclusion] = []
+    for game in games:
+        if (
+            game.home_team_id in cfg.il_college_espn_ids
+            or game.away_team_id in cfg.il_college_espn_ids
+        ):
+            exclusions.append(Exclusion(game.game_id, EXCL_IL_COLLEGE))
+            continue
+        if (
+            not game.home_team_id
+            or not game.away_team_id
+            or (
+                known_team_ids is not None
+                and (
+                    game.home_team_id not in known_team_ids
+                    or game.away_team_id not in known_team_ids
+                )
+            )
+        ):
+            exclusions.append(Exclusion(game.game_id, EXCL_TEAMS_UNRESOLVED))
+            continue
+        if game.no_contest or game.home_score is None or game.away_score is None:
+            exclusions.append(Exclusion(game.game_id, EXCL_NO_CONTEST))
+            continue
+        if not resolved.include_fcs_opponents and not (
+            game.home_fbs and game.away_fbs
+        ):
+            exclusions.append(Exclusion(game.game_id, EXCL_NON_FBS_OPPONENT))
+            continue
+        population.append(game)
+    return population, exclusions
+
+
+# --------------------------------------------------------------------------
+# Scoring metrics and uncertainty (draft sections 5.1 and 5.2)
+# --------------------------------------------------------------------------
+
+
+def brier(probability: float, outcome: float) -> float:
+    return (probability - outcome) ** 2
+
+
+def log_loss(probability: float, outcome: float, eps: float) -> float:
+    p = min(max(probability, eps), 1.0 - eps)
+    return -(outcome * math.log(p) + (1.0 - outcome) * math.log(1.0 - p))
+
+
+@dataclass(frozen=True)
+class ScoredRow:
+    """One paired observation: candidate and comparator scored on the
+    same game, at the same line, against the same outcome."""
+
+    game_id: str
+    family: str
+    season: int
+    block: str  # week block: "season:week" — the bootstrap cluster unit
+    p_candidate: float
+    p_comparator: float
+    outcome: float
+
+    def delta_brier(self) -> float:
+        return brier(self.p_candidate, self.outcome) - brier(
+            self.p_comparator, self.outcome
+        )
+
+    def delta_log_loss(self, eps: float) -> float:
+        return log_loss(self.p_candidate, self.outcome, eps) - log_loss(
+            self.p_comparator, self.outcome, eps
+        )
+
+
+def cluster_bootstrap_ci(
+    rows: Sequence[ScoredRow],
+    value: Callable[[ScoredRow], float],
+    *,
+    reps: int,
+    seed: Optional[int],
+) -> tuple[float, float, float]:
+    """95% percentile CI for the mean of ``value`` over rows, by cluster
+    bootstrap over week blocks (draft section 5.2). Both team_total rows
+    of a game share the game's block, so they resample together.
+    Returns (point estimate, ci_low, ci_high). Deterministic given the
+    seed; seed determinism is a pre-scoring kill criterion (section 7).
+    """
+    if not rows:
+        raise HarnessError("bootstrap over zero rows")
+    blocks: dict[str, list[ScoredRow]] = {}
+    for row in rows:
+        blocks.setdefault(row.block, []).append(row)
+    block_keys = sorted(blocks)
+    point = sum(value(r) for r in rows) / len(rows)
+    rng = random.Random(seed)
+    estimates: list[float] = []
+    for _ in range(reps):
+        total = 0.0
+        count = 0
+        for _ in range(len(block_keys)):
+            key = block_keys[rng.randrange(len(block_keys))]
+            for row in blocks[key]:
+                total += value(row)
+                count += 1
+        estimates.append(total / count)
+    estimates.sort()
+    lo = estimates[int(0.025 * (len(estimates) - 1))]
+    hi = estimates[int(0.975 * (len(estimates) - 1))]
+    return point, lo, hi
+
+
+def calibration_recalibration(
+    rows: Sequence[ScoredRow], eps: float
+) -> Optional[tuple[float, float]]:
+    """Descriptive logistic recalibration of outcome on candidate
+    log-odds (draft section 5.1): returns (slope, intercept) or None
+    when not estimable. Never gated; a defect is disclosed, not hidden.
+    """
+    xs: list[float] = []
+    ys: list[float] = []
+    for row in rows:
+        p = min(max(row.p_candidate, eps), 1.0 - eps)
+        xs.append(math.log(p / (1.0 - p)))
+        ys.append(row.outcome)
+    if len(xs) < 20 or len(set(ys)) < 2:
+        return None
+    slope, intercept = 1.0, 0.0
+    for _ in range(50):
+        # Newton-Raphson on the two-parameter logistic fit.
+        g0 = g1 = h00 = h01 = h11 = 0.0
+        for x, y in zip(xs, ys):
+            z = intercept + slope * x
+            p = 1.0 / (1.0 + math.exp(-z)) if z > -700 else 0.0
+            w = max(p * (1.0 - p), 1e-12)
+            r = y - p
+            g0 += r
+            g1 += r * x
+            h00 += w
+            h01 += w * x
+            h11 += w * x * x
+        det = h00 * h11 - h01 * h01
+        if abs(det) < 1e-12:
+            return None
+        d0 = (h11 * g0 - h01 * g1) / det
+        d1 = (h00 * g1 - h01 * g0) / det
+        intercept += d0
+        slope += d1
+        if abs(d0) + abs(d1) < 1e-9:
+            break
+    if not (math.isfinite(slope) and math.isfinite(intercept)):
+        return None
+    return slope, intercept
+
+
+# --------------------------------------------------------------------------
+# Freeze manifest (draft section 3.3)
+# --------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class FreezeManifest:
+    """The freeze record. ``freeze_sha`` is named by the owner at
+    filing from the then-current verified main head — this module
+    selects no SHA, and a manifest without one establishes nothing."""
+
+    freeze_sha: Optional[str] = None
+    artifact_sha256: Optional[str] = None
+    feature_schema_sha256: Optional[str] = None
+    predictive_code_manifest_sha256: Optional[str] = None
+    acquisition_code_manifest_sha256: Optional[str] = None
+    policy_sha256: Optional[str] = None
+    close_definition_id: Optional[str] = None
+    #: path -> expected SHA-256 for every frozen file, verified before
+    #: any parse or scoring (draft section 7, kill criterion 1).
+    file_hashes: Mapping[str, str] = field(default_factory=dict)
+
+    def is_established(self) -> bool:
+        return bool(
+            self.freeze_sha
+            and self.artifact_sha256
+            and self.feature_schema_sha256
+            and self.predictive_code_manifest_sha256
+            and self.acquisition_code_manifest_sha256
+            and self.policy_sha256
+            and self.close_definition_id
+        )
+
+    def verify_files(self, file_bytes: Mapping[str, bytes]) -> Optional[str]:
+        """Returns a NOT_RUN reason on the first mismatch, else None."""
+        for path, expected in sorted(self.file_hashes.items()):
+            actual_bytes = file_bytes.get(path)
+            if actual_bytes is None:
+                return NOT_RUN_FREEZE_HASH_MISMATCH
+            actual = hashlib.sha256(actual_bytes).hexdigest()
+            if actual != expected:
+                return NOT_RUN_FREEZE_HASH_MISMATCH
+        return None
+
+
+# --------------------------------------------------------------------------
+# PIT audit (draft sections 4.1 and 7)
+# --------------------------------------------------------------------------
+
+
+def audit_external_features(
+    features: Sequence[ExternalFeature], games_by_id: Mapping[str, GameRecord]
+) -> None:
+    for feature in features:
+        game = games_by_id.get(feature.game_id)
+        if game is None:
+            raise PitAuditError(
+                "external feature %r bound to unknown game %s"
+                % (feature.name, feature.game_id)
+            )
+        if not feature.available_at < game.kickoff_utc:
+            raise PitAuditError(
+                "external feature %r for game %s became available at %s, "
+                "not strictly before kickoff %s"
+                % (
+                    feature.name,
+                    feature.game_id,
+                    feature.available_at.isoformat(),
+                    game.kickoff_utc.isoformat(),
+                )
+            )
+
+
+def audit_prediction_evidence(
+    predictions: Sequence["PredictionRecord"],
+    games_by_id: Mapping[str, GameRecord],
+) -> None:
+    """Every game whose result informed a prediction must have kicked
+    off strictly before the predicted game."""
+    for prediction in predictions:
+        target = games_by_id[prediction.game_id]
+        for evidence_id in prediction.evidence_game_ids:
+            evidence = games_by_id[evidence_id]
+            if not evidence.kickoff_utc < target.kickoff_utc:
+                raise PitAuditError(
+                    "prediction for game %s used result of game %s, "
+                    "which did not kick off strictly before it"
+                    % (prediction.game_id, evidence_id)
+                )
+
+
+# --------------------------------------------------------------------------
+# Fold engine (draft section 4.1) and the historical-leg run
+# --------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PredictionRecord:
+    game_id: str
+    season: int
+    week: int
+    candidate: FamilyProbabilities
+    baseline: FamilyProbabilities
+    evidence_game_ids: tuple[str, ...]
+
+    @property
+    def block(self) -> str:
+        return "%d:%d" % (self.season, self.week)
+
+
+@dataclass
+class AttemptLedger:
+    """Draft section 7 consumption accounting. A completed scored run
+    consumes one attempt regardless of outcome; a pre-scoring abort
+    (NOT_RUN) consumes nothing; a post-hoc void consumes and is never
+    refunded."""
+
+    budget: int = 3
+    consumed: int = 0
+    voided: int = 0
+
+    def consume_completed_run(self) -> None:
+        if self.consumed >= self.budget:
+            raise HarnessError("attempt budget exhausted")
+        self.consumed += 1
+
+    def record_void(self) -> None:
+        self.voided += 1
+
+
+@dataclass
+class ProgramResult:
+    status: str  # "SCORED" or "NOT_RUN"
+    reason: Optional[str]
+    family_records: list = field(default_factory=list)
+    descriptive_records: list = field(default_factory=list)
+    exclusions: list = field(default_factory=list)
+    predictions: list = field(default_factory=list)
+    attempts_consumed: int = 0
+
+    def all_records(self) -> list:
+        return list(self.family_records) + list(self.descriptive_records)
+
+    def result_hash(self) -> str:
+        payload = json.dumps(
+            {
+                "status": self.status,
+                "reason": self.reason,
+                "family_records": self.family_records,
+                "descriptive_records": self.descriptive_records,
+                "exclusions": [
+                    {"game_id": e.game_id, "reason": e.reason}
+                    for e in self.exclusions
+                ],
+            },
+            sort_keys=True,
+            default=str,
+        )
+        return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def _invariant_fields(evaluated_object: str) -> dict:
+    """Fields every emitted record carries, whatever its content."""
+    return {
+        "family_status": FAMILY_STATUS_UNVALIDATED,
+        "status_change": "NONE",
+        "evaluated_object": evaluated_object,
+        "program": "CFB_FOUR_FAMILY_EVALUATION_V1",
+    }
+
+
+def _family_rows(
+    predictions: Sequence[PredictionRecord],
+    games_by_id: Mapping[str, GameRecord],
+    lines_by_game: Mapping[str, GameLines],
+    family: str,
+) -> tuple[list[ScoredRow], int]:
+    """Paired rows for one family (candidate vs baseline, same game,
+    same line, same outcome). Pushes are excluded and counted."""
+    rows: list[ScoredRow] = []
+    pushes = 0
+    for prediction in predictions:
+        game = games_by_id[prediction.game_id]
+        lines = lines_by_game.get(prediction.game_id, GameLines())
+        cand = prediction.candidate
+        base = prediction.baseline
+        if family == "moneyline":
+            outcome = grade_outcome(game, family, lines)
+            if outcome is None:
+                continue
+            rows.append(
+                ScoredRow(
+                    game.game_id, family, game.season, prediction.block,
+                    cand.moneyline_home_win, base.moneyline_home_win, outcome,
+                )
+            )
+        elif family == "spread":
+            outcome = grade_outcome(game, family, lines)
+            if outcome is None:
+                if lines.spread_home is not None and game.decided:
+                    pushes += 1
+                continue
+            if cand.spread_home_cover is None or base.spread_home_cover is None:
+                continue
+            rows.append(
+                ScoredRow(
+                    game.game_id, family, game.season, prediction.block,
+                    cand.spread_home_cover, base.spread_home_cover, outcome,
+                )
+            )
+        elif family == "total":
+            outcome = grade_outcome(game, family, lines)
+            if outcome is None:
+                if lines.total is not None and game.decided:
+                    pushes += 1
+                continue
+            if cand.total_over is None or base.total_over is None:
+                continue
+            rows.append(
+                ScoredRow(
+                    game.game_id, family, game.season, prediction.block,
+                    cand.total_over, base.total_over, outcome,
+                )
+            )
+        elif family == "team_total":
+            for side, cand_p, base_p in (
+                ("home", cand.team_total_home_over, base.team_total_home_over),
+                ("away", cand.team_total_away_over, base.team_total_away_over),
+            ):
+                outcome = grade_outcome(game, family, lines, side=side)
+                if outcome is None:
+                    line = (
+                        lines.team_total_home
+                        if side == "home"
+                        else lines.team_total_away
+                    )
+                    if line is not None and game.decided:
+                        pushes += 1
+                    continue
+                if cand_p is None or base_p is None:
+                    continue
+                rows.append(
+                    ScoredRow(
+                        game.game_id, family, game.season,
+                        prediction.block, cand_p, base_p, outcome,
+                    )
+                )
+    return rows, pushes
+
+
+# --------------------------------------------------------------------------
+# Verdict functions (draft sections 5.4 and 5.5)
+#
+# Pure functions over scored rows. Their maximum outputs are the draft's
+# ceilings; neither can change a family status, and every record they
+# produce carries the invariant fields.
+# --------------------------------------------------------------------------
+
+
+def historical_verdict(
+    family: str,
+    rows: Sequence[ScoredRow],
+    *,
+    config: EvalConfig,
+    scored_fraction: float,
+    evaluated_object: str = EVALUATED_OBJECT_INJURY_NEUTRAL,
+) -> dict:
+    """The historical-leg verdict vs the frozen baseline (section 5.4).
+    Ceiling: BEATS_FROZEN_BASELINE. A pass changes no status."""
+    record = dict(_invariant_fields(evaluated_object))
+    record.update(
+        {
+            "record_type": "HISTORICAL_BASELINE_VERDICT",
+            "family": family,
+            "n_pooled": len(rows),
+            "scored_fraction": scored_fraction,
+        }
+    )
+    folds_present = len({r.season for r in rows})
+    record["folds_present"] = folds_present
+    if len(rows) < config.pooled_min_games or folds_present < len(
+        config.evaluation_seasons
+    ):
+        record["verdict"] = None
+        record["not_run_reason"] = NOT_RUN_INSUFFICIENT_BOUND_DATA
+        return record
+    eps = config.log_loss_eps
+    b_point, b_lo, b_hi = cluster_bootstrap_ci(
+        rows, lambda r: r.delta_brier(),
+        reps=config.bootstrap_reps, seed=config.bootstrap_seed,
+    )
+    l_point, l_lo, l_hi = cluster_bootstrap_ci(
+        rows, lambda r: r.delta_log_loss(eps),
+        reps=config.bootstrap_reps, seed=config.bootstrap_seed,
+    )
+    record["delta_brier"] = {"point": b_point, "ci_low": b_lo, "ci_high": b_hi}
+    record["delta_log_loss"] = {
+        "point": l_point, "ci_low": l_lo, "ci_high": l_hi,
+    }
+    folds_better = 0
+    per_fold = {}
+    for season in sorted({r.season for r in rows}):
+        fold_rows = [r for r in rows if r.season == season]
+        fb = sum(r.delta_brier() for r in fold_rows) / len(fold_rows)
+        fl = sum(r.delta_log_loss(eps) for r in fold_rows) / len(fold_rows)
+        per_fold[str(season)] = {
+            "n": len(fold_rows), "delta_brier": fb, "delta_log_loss": fl,
+        }
+        if fb < 0.0 and fl < 0.0:
+            folds_better += 1
+    record["per_fold"] = per_fold
+    record["folds_better_on_both_metrics"] = folds_better
+    calibration = calibration_recalibration(rows, eps)
+    if calibration is None:
+        record["calibration"] = "CALIBRATION_NOT_ESTIMABLE"
+    else:
+        slope, intercept = calibration
+        record["calibration"] = {"slope": slope, "intercept": intercept}
+        lo_s, hi_s = config.calibration_slope_band
+        if not (lo_s <= slope <= hi_s) or abs(intercept) > (
+            config.calibration_intercept_band
+        ):
+            record["calibration_flag"] = "CALIBRATION_DEFECT"
+    if scored_fraction < config.coverage_floor:
+        # The coverage presumption governs regardless of metrics.
+        record["verdict"] = VERDICT_INCONCLUSIVE_COVERAGE
+        return record
+    if b_hi < 0.0 and l_hi < 0.0 and folds_better >= config.folds_required_better:
+        record["verdict"] = VERDICT_BEATS_FROZEN_BASELINE
+    elif b_lo > 0.0 or l_lo > 0.0:
+        record["verdict"] = VERDICT_WORSE_THAN_FROZEN_BASELINE
+    else:
+        record["verdict"] = VERDICT_INCONCLUSIVE
+    return record
+
+
+def forward_verdict(
+    family: str,
+    rows: Sequence[ScoredRow],
+    *,
+    config: EvalConfig,
+    sensitivity_rows: Optional[Sequence[ScoredRow]] = None,
+) -> dict:
+    """The forward-leg verdict vs the DK no-vig close (section 5.5),
+    pre-registered here for the future paired-capture cohort. Ceiling:
+    DEMONSTRATED_EDGE_RESEARCH_ONLY. Below target this emits an
+    accrual record, never a verdict, and there are no interim verdicts.
+    """
+    record = dict(_invariant_fields(EVALUATED_OBJECT_PRODUCTION_FORWARD))
+    record.update(
+        {
+            "record_type": "FORWARD_MARKET_VERDICT",
+            "family": family,
+            "n_games": len({r.game_id for r in rows}),
+            "n_blocks": len({r.block for r in rows}),
+        }
+    )
+    if (
+        record["n_games"] < config.forward_target_games
+        or record["n_blocks"] < config.forward_target_blocks
+    ):
+        record["verdict"] = None
+        record["label"] = ACCRUAL_ONLY_NOT_A_VERDICT
+        return record
+    eps = config.log_loss_eps
+    b_point, b_lo, b_hi = cluster_bootstrap_ci(
+        rows, lambda r: r.delta_brier(),
+        reps=config.bootstrap_reps, seed=config.bootstrap_seed,
+    )
+    l_point, l_lo, l_hi = cluster_bootstrap_ci(
+        rows, lambda r: r.delta_log_loss(eps),
+        reps=config.bootstrap_reps, seed=config.bootstrap_seed,
+    )
+    record["delta_brier"] = {"point": b_point, "ci_low": b_lo, "ci_high": b_hi}
+    record["delta_log_loss"] = {
+        "point": l_point, "ci_low": l_lo, "ci_high": l_hi,
+    }
+    if sensitivity_rows is not None:
+        s_point_b = sum(r.delta_brier() for r in sensitivity_rows) / len(
+            sensitivity_rows
+        )
+        p_point_b = sum(r.delta_brier() for r in rows) / len(rows)
+        if (s_point_b < 0.0) != (p_point_b < 0.0):
+            record["method_sensitive"] = True
+            record["verdict"] = VERDICT_INCONCLUSIVE
+            return record
+    if b_hi < 0.0 and l_hi < 0.0:
+        record["verdict"] = VERDICT_DEMONSTRATED_EDGE_RESEARCH_ONLY
+    elif b_lo > 0.0 or l_lo > 0.0:
+        record["verdict"] = VERDICT_REFUTED
+    else:
+        record["verdict"] = VERDICT_INCONCLUSIVE
+    return record
+
+
+def forward_extension_available(
+    verdict_record: Mapping, *, config: EvalConfig, already_extended: bool
+) -> bool:
+    """The single predeclared extension (section 5.5): an INCONCLUSIVE
+    verdict at target with favorable point estimates on both metrics
+    may extend once, to the extension target. No second extension."""
+    if already_extended or verdict_record.get("verdict") != VERDICT_INCONCLUSIVE:
+        return False
+    brier = verdict_record.get("delta_brier") or {}
+    logloss = verdict_record.get("delta_log_loss") or {}
+    favorable = (
+        brier.get("point", 0.0) < 0.0 and logloss.get("point", 0.0) < 0.0
+    )
+    below_extension_target = verdict_record.get(
+        "n_games", 0
+    ) < config.forward_extension_games
+    return favorable and below_extension_target
+
+
+# --------------------------------------------------------------------------
+# CFBD descriptive comparison (draft sections 2.1, 5.3, 5.4)
+#
+# Descriptive only, structurally: this section's functions return
+# records whose "verdict" field is None by construction, and every
+# record carries DESCRIPTIVE_LABEL plus the verbatim limitation text.
+# --------------------------------------------------------------------------
+
+
+def _no_vig_proportional(home_ml: int, away_ml: int) -> tuple[float, float]:
+    def implied(ml: int) -> float:
+        return (-ml) / (-ml + 100.0) if ml < 0 else 100.0 / (ml + 100.0)
+
+    h, a = implied(home_ml), implied(away_ml)
+    total = h + a
+    return h / total, a / total
+
+
+def descriptive_market_comparison(
+    family: str,
+    predictions: Sequence[PredictionRecord],
+    games_by_id: Mapping[str, GameRecord],
+    lines_by_game: Mapping[str, GameLines],
+    *,
+    config: EvalConfig,
+) -> dict:
+    """Per-family descriptive comparison vs CFBD-close-implied
+    probabilities. NOT A VERDICT — see the label on the record."""
+    record = dict(_invariant_fields(EVALUATED_OBJECT_INJURY_NEUTRAL))
+    record.update(
+        {
+            "record_type": "DESCRIPTIVE_MARKET_COMPARISON",
+            "family": family,
+            "comparison_label": DESCRIPTIVE_LABEL,
+            "label_text": DESCRIPTIVE_LIMITATION_TEXT,
+            "verdict": None,
+        }
+    )
+    if family == "team_total":
+        # CFBD's audited schema carries no team-total lines; there is
+        # no comparator, descriptive or otherwise (draft section 2.4).
+        record["market_comparator"] = NO_HISTORICAL_MARKET_COMPARATOR
+        return record
+    rows: list[ScoredRow] = []
+    construction = None
+    for prediction in predictions:
+        game = games_by_id[prediction.game_id]
+        lines = lines_by_game.get(prediction.game_id, GameLines())
+        cand = prediction.candidate
+        if family == "moneyline":
+            if lines.home_moneyline is None or lines.away_moneyline is None:
+                continue
+            p_market, _ = _no_vig_proportional(
+                lines.home_moneyline, lines.away_moneyline
+            )
+            construction = "NO_VIG_PROPORTIONAL_FROM_CFBD_MONEYLINES"
+            outcome = grade_outcome(game, family, lines)
+            p_cand = cand.moneyline_home_win
+        elif family == "spread":
+            if lines.spread_home is None:
+                continue
+            # Implied parity: the market is treated as pricing the
+            # cover at 0.5 at its own line (draft section 5.3). This is
+            # not a priced no-vig pair.
+            construction = "IMPLIED_PARITY_AT_CFBD_LINE_NOT_A_PRICED_PAIR"
+            p_market = 0.5
+            outcome = grade_outcome(game, family, lines)
+            p_cand = cand.spread_home_cover
+        elif family == "total":
+            if lines.total is None:
+                continue
+            construction = "IMPLIED_PARITY_AT_CFBD_LINE_NOT_A_PRICED_PAIR"
+            p_market = 0.5
+            outcome = grade_outcome(game, family, lines)
+            p_cand = cand.total_over
+        else:
+            raise HarnessError("unknown family %r" % (family,))
+        if outcome is None or p_cand is None:
+            continue
+        rows.append(
+            ScoredRow(
+                game.game_id, family, game.season, prediction.block,
+                p_cand, p_market, outcome,
+            )
+        )
+    record["construction"] = construction
+    record["n"] = len(rows)
+    if rows:
+        eps = config.log_loss_eps
+        record["delta_brier"] = sum(r.delta_brier() for r in rows) / len(rows)
+        record["delta_log_loss"] = sum(
+            r.delta_log_loss(eps) for r in rows
+        ) / len(rows)
+    return record
+
+
+# --------------------------------------------------------------------------
+# The historical-leg run
+# --------------------------------------------------------------------------
+
+#: Hook invoked once per fold with the fold's training-window games
+#: ONLY (draft section 4.1: all selection inside the training window).
+SelectionHook = Callable[[int, Sequence[GameRecord]], None]
+
+
+def run_historical_leg(
+    games: Sequence[GameRecord],
+    lines_by_game: Mapping[str, GameLines],
+    *,
+    config: EvalConfig,
+    freeze: FreezeManifest,
+    candidate: ProbabilityProducer,
+    freeze_file_bytes: Optional[Mapping[str, bytes]] = None,
+    external_features: Sequence[ExternalFeature] = (),
+    raw_contexts: Optional[Mapping[str, Mapping[str, float]]] = None,
+    selection_hook: Optional[SelectionHook] = None,
+    ledger: Optional[AttemptLedger] = None,
+) -> ProgramResult:
+    """Run the historical leg over bound in-memory records.
+
+    Every gate that can refuse does so pre-scoring and returns NOT_RUN
+    (consuming no attempt): unresolved owner rulings, unestablished
+    freeze, freeze hash mismatch, forward-only candidate mode, PIT
+    audit failure, neutrality-guard refusal, fold floors. A completed
+    scored run consumes exactly one attempt on ``ledger``.
+    """
+    config.validate()
+    try:
+        resolved = resolve_config(config)
+    except ConfigError:
+        return ProgramResult(
+            status="NOT_RUN", reason=NOT_RUN_OWNER_RULINGS_UNRESOLVED
+        )
+    if not freeze.is_established():
+        return ProgramResult(
+            status="NOT_RUN", reason=NOT_RUN_FREEZE_NOT_ESTABLISHED
+        )
+    if freeze_file_bytes is not None:
+        mismatch = freeze.verify_files(freeze_file_bytes)
+        if mismatch is not None:
+            return ProgramResult(status="NOT_RUN", reason=mismatch)
+    if resolved.candidate_mode == "CAND_3_FORWARD_ONLY":
+        return ProgramResult(
+            status="NOT_RUN", reason=NOT_RUN_FORWARD_ONLY_CANDIDATE
+        )
+
+    games_by_id = {g.game_id: g for g in games}
+    try:
+        audit_external_features(external_features, games_by_id)
+    except PitAuditError:
+        return ProgramResult(
+            status="NOT_RUN", reason=NOT_RUN_PIT_AUDIT_FAILURE
+        )
+
+    population, exclusions = classify_population(games, resolved)
+    population_ids = {g.game_id for g in population}
+    baseline = RatingsBaselineProducer(config)
+
+    # Single chronological walk-forward pass. Ratings state for a game
+    # is snapshotted before its result is folded in; evaluation-season
+    # games are predicted, then their results update the state (draft
+    # section 4.1 within-fold walk-forward).
+    ordered = sorted(population, key=lambda g: (g.kickoff_utc, g.game_id))
+    state = RatingsState(config)
+    predictions: list[PredictionRecord] = []
+    selection_called_for: set[int] = set()
+    try:
+        for game in ordered:
+            if game.season in resolved.evaluation_seasons:
+                if selection_hook is not None and (
+                    game.season not in selection_called_for
+                ):
+                    training = [
+                        g
+                        for g in population
+                        if g.season < game.season
+                    ]
+                    selection_hook(game.season, training)
+                    selection_called_for.add(game.season)
+                inp = build_candidate_input(
+                    game,
+                    home_rating=state.rating(game.home_team_id),
+                    away_rating=state.rating(game.away_team_id),
+                    home_advantage_points=config.home_advantage_points,
+                    raw_context=(raw_contexts or {}).get(game.game_id),
+                )
+                inp.validate_neutral()
+                lines = lines_by_game.get(game.game_id, GameLines())
+                predictions.append(
+                    PredictionRecord(
+                        game_id=game.game_id,
+                        season=game.season,
+                        week=game.week,
+                        candidate=candidate.family_probabilities(inp, lines),
+                        baseline=baseline.family_probabilities(inp, lines),
+                        evidence_game_ids=tuple(state.evidence_game_ids),
+                    )
+                )
+            state.update(game)
+    except NonNeutralInputError:
+        return ProgramResult(
+            status="NOT_RUN",
+            reason=NOT_RUN_NEUTRALITY_GUARD_REFUSAL,
+            exclusions=exclusions,
+        )
+
+    try:
+        audit_prediction_evidence(predictions, games_by_id)
+    except PitAuditError:
+        return ProgramResult(
+            status="NOT_RUN",
+            reason=NOT_RUN_PIT_AUDIT_FAILURE,
+            exclusions=exclusions,
+        )
+
+    evaluated_object = EVALUATED_OBJECT_INJURY_NEUTRAL
+    family_records: list[dict] = []
+    families_below_floor = 0
+    scored_games_by_family: dict[str, set] = {}
+    for family in config.families:
+        rows, pushes = _family_rows(
+            predictions, games_by_id, lines_by_game, family
+        )
+        scored_games_by_family[family] = {r.game_id for r in rows}
+        fold_counts = {}
+        for season in resolved.evaluation_seasons:
+            fold_counts[season] = len(
+                [r for r in rows if r.season == season]
+            )
+        record = dict(_invariant_fields(evaluated_object))
+        record.update(
+            {
+                "record_type": "HISTORICAL_FAMILY_RESULT",
+                "family": family,
+                "fold_counts": {str(k): v for k, v in fold_counts.items()},
+                "push_exclusions": pushes,
+                "push_exclusion_reason": EXCL_PUSH_INTEGER_LINE,
+            }
+        )
+        if any(
+            count < config.fold_min_games for count in fold_counts.values()
+        ):
+            record["verdict"] = None
+            record["not_run_reason"] = NOT_RUN_FOLD_BELOW_MINIMUM
+            families_below_floor += 1
+            family_records.append(record)
+            continue
+        population_for_family = len(
+            [g for g in population if g.season in resolved.evaluation_seasons]
+        )
+        scored_fraction = (
+            len(scored_games_by_family[family]) / population_for_family
+            if population_for_family
+            else 0.0
+        )
+        verdict_record = historical_verdict(
+            family,
+            rows,
+            config=replace(
+                config, evaluation_seasons=resolved.evaluation_seasons
+            ),
+            scored_fraction=scored_fraction,
+            evaluated_object=evaluated_object,
+        )
+        verdict_record["push_exclusions"] = pushes
+        verdict_record["push_exclusion_reason"] = EXCL_PUSH_INTEGER_LINE
+        verdict_record["fold_counts"] = {
+            str(k): v for k, v in fold_counts.items()
+        }
+        family_records.append(verdict_record)
+
+    descriptive = [
+        descriptive_market_comparison(
+            family, predictions, games_by_id, lines_by_game, config=config
+        )
+        for family in config.families
+    ]
+
+    if families_below_floor >= 2:
+        return ProgramResult(
+            status="NOT_RUN",
+            reason=NOT_RUN_PROGRAM_ABORT,
+            family_records=family_records,
+            descriptive_records=descriptive,
+            exclusions=exclusions,
+            predictions=predictions,
+        )
+
+    if ledger is not None:
+        ledger.consume_completed_run()
+    return ProgramResult(
+        status="SCORED",
+        reason=None,
+        family_records=family_records,
+        descriptive_records=descriptive,
+        exclusions=exclusions,
+        predictions=predictions,
+        attempts_consumed=1 if ledger is not None else 0,
+    )
